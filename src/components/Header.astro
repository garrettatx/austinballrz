---
import { site, navigation } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="bg-white border-b border-gray-200" slot="header">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-extrabold tracking-tight text-[var(--ballrz-dark)]">
      Austin Ball'rz
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-6" aria-label="Main navigation">
      {navigation.map(item => (
        <a
          href={item.href}
          class:list={[
            'text-sm font-semibold transition-colors',
            currentPath === item.href
              ? 'text-[var(--ballrz-purple)]'
              : 'text-[var(--ballrz-gray-600)] hover:text-[var(--ballrz-purple)]',
          ]}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-[var(--ballrz-gray-600)]"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Rainbow bar -->
  <div class="ballrz-rainbow h-1" aria-hidden="true"></div>

  <!-- Mobile nav -->
  <nav id="mobile-menu" class="md:hidden hidden bg-white border-b border-gray-200" aria-label="Mobile navigation">
    <div class="px-6 py-3 space-y-1">
      {navigation.map(item => (
        <a
          href={item.href}
          class:list={[
            'block text-sm font-semibold py-2.5',
            currentPath === item.href
              ? 'text-[var(--ballrz-purple)]'
              : 'text-[var(--ballrz-gray-600)]',
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script is:inline>
(function() {
  var btn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  if (!btn || !menu) return;
  btn.addEventListener('click', function() {
    var open = menu.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', !open);
  });
})();
</script>
