---
import { site, navigation } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header slot="header">
  <div class="bg-[#263a5a]">
    <div class="max-w-5xl mx-auto px-6 flex items-center justify-between">
      <a href="/">
        <img src="/images/logo.svg" alt={site.name} width="200" height="140" style="width: 140px; margin: -1.5rem 0; filter: drop-shadow(0 0 4px rgba(255,255,255,0.3)) drop-shadow(0 0 8px rgba(255,255,255,0.15));" />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-5" aria-label="Main navigation" style="font-family: var(--font-heading);">
        {navigation.map(item => (
          <a
            href={item.href}
            class:list={[
              'text-base font-semibold uppercase tracking-widest transition-colors',
              currentPath === item.href
                ? 'text-white'
                : 'text-white/60 hover:text-white',
            ]}
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-white/70 hover:text-white"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Rainbow bar -->
  <div class="ballrz-rainbow h-1" aria-hidden="true"></div>

  <!-- Mobile nav -->
  <nav id="mobile-menu" class="md:hidden hidden bg-[#263a5a] border-t border-white/10" aria-label="Mobile navigation" style="font-family: var(--font-heading);">
    <div class="px-6 py-3 space-y-0.5">
      {navigation.map(item => (
        <a
          href={item.href}
          class:list={[
            'block text-sm font-semibold uppercase tracking-widest py-2.5',
            currentPath === item.href
              ? 'text-white'
              : 'text-white/60',
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<script is:inline>
(function() {
  var btn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  if (!btn || !menu) return;
  btn.addEventListener('click', function() {
    var open = menu.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', !open);
  });
})();
</script>
