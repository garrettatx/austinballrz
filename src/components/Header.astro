---
import { site, navigation, allPages } from '../data/site';

// Secondary pages: in allPages but not in main navigation
const secondaryPages = allPages.filter(p => !navigation.some(n => n.href === p.href));

const currentPath = Astro.url.pathname;
---

<header slot="header">
  <div style="background: var(--color-surface);">
    <div class="container flex items-center justify-between" style="padding-block: var(--space-4);">
      <a href="/">
        <img src="/images/logo-original.svg" alt={site.name} width="147" height="74" style="width: 140px;" />
      </a>

      {/* Desktop nav */}
      <nav class="hidden lg:flex items-center" style="gap: var(--space-6); font-family: var(--font-heading);" aria-label="Main navigation">
        {navigation.map(item => (
          <a
            href={item.href}
            class:list={[
              'uppercase font-semibold transition-colors border-b-2',
              currentPath === item.href
                ? 'text-white border-[var(--color-accent-light)]'
                : 'text-[var(--color-nav-inactive)] hover:text-white border-transparent hover:border-white/30',
            ]}
            style={`font-size: var(--text-lg); letter-spacing: 0.04em; padding-block: var(--space-2);`}
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      {/* Mobile menu button — hamburger / X toggle */}
      <button
        id="mobile-menu-btn"
        class="lg:hidden text-white/70 hover:text-white"
        style={`padding: var(--space-2); position: relative; width: 40px; height: 40px;`}
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-menu" class="w-6 h-6 absolute inset-0 m-auto transition-opacity duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 absolute inset-0 m-auto transition-opacity duration-200 opacity-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  {/* Rainbow bar */}
  <div class="ballrz-rainbow" style="height: 4px;" aria-hidden="true"></div>

  {/* Mobile nav — slide down */}
  <nav
    id="mobile-menu"
    class="lg:hidden"
    style={`background: var(--color-surface); font-family: var(--font-heading); overflow: hidden; max-height: 0; transition: max-height 0.3s ease;`}
    aria-label="Mobile navigation"
  >
    <div style={`padding: var(--space-4) var(--space-6);`}>
      {navigation.map(item => (
        <a
          href={item.href}
          class:list={[
            'mobile-nav-link block uppercase font-semibold',
            currentPath === item.href ? 'text-white' : 'text-[var(--color-nav-inactive)]',
          ]}
          style={`font-size: var(--text-base); letter-spacing: 0.06em; padding-block: var(--space-3); border-left: 3px solid ${currentPath === item.href ? 'var(--color-accent-light)' : 'transparent'}; padding-left: var(--space-3);`}
          aria-current={currentPath === item.href ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      {secondaryPages.length > 0 && (
        <>
          <div style={`border-top: 1px solid rgba(255,255,255,0.1); margin-block: var(--space-2);`} aria-hidden="true"></div>
          {secondaryPages.map(item => (
            <a
              href={item.href}
              class:list={[
                'mobile-nav-link block font-semibold',
                currentPath === item.href ? 'text-white' : 'text-[var(--color-nav-inactive)]',
              ]}
              style={`font-size: var(--text-sm); letter-spacing: 0.06em; padding-block: var(--space-3); border-left: 3px solid ${currentPath === item.href ? 'var(--color-accent-light)' : 'transparent'}; padding-left: var(--space-3);`}
            >
              {item.label}
            </a>
          ))}
        </>
      )}
    </div>
  </nav>
</header>

<script is:inline>
(function() {
  var btn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  var iconMenu = document.getElementById('icon-menu');
  var iconClose = document.getElementById('icon-close');
  if (!btn || !menu) return;

  var isOpen = false;

  function toggle() {
    isOpen = !isOpen;
    btn.setAttribute('aria-expanded', isOpen);
    btn.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');

    if (isOpen) {
      menu.style.maxHeight = menu.scrollHeight + 'px';
    } else {
      menu.style.maxHeight = '0';
    }

    // Icon swap
    iconMenu.style.opacity = isOpen ? '0' : '1';
    iconClose.style.opacity = isOpen ? '1' : '0';
  }

  function close() {
    if (!isOpen) return;
    toggle();
  }

  btn.addEventListener('click', toggle);

  // Close when a nav link is tapped
  menu.querySelectorAll('.mobile-nav-link').forEach(function(link) {
    link.addEventListener('click', close);
  });

  // Close on outside click
  document.addEventListener('click', function(e) {
    if (isOpen && !menu.contains(e.target) && !btn.contains(e.target)) {
      close();
    }
  });
})();
</script>
