---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-xs text-gray-400 mb-4">
  <ol class="flex items-center gap-1.5">
    <li>
      <a href="/" class="hover:text-gray-600 transition-colors">Home</a>
    </li>
    {items.map((item, i) => (
      <>
        <li aria-hidden="true" class="text-gray-300">/</li>
        <li>
          {item.href && i < items.length - 1
            ? <a href={item.href} class="hover:text-gray-600 transition-colors">{item.label}</a>
            : <span class="text-gray-600" aria-current="page">{item.label}</span>
          }
        </li>
      </>
    ))}
  </ol>
</nav>
