---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" style={`font-size: var(--text-sm); color: var(--color-muted); margin-bottom: var(--space-4);`}>
  <ol class="flex items-center" style={`gap: var(--space-2);`}>
    <li>
      <a href="/" class="hover:text-[var(--color-body)] transition-colors">Home</a>
    </li>
    {items.map((item, i) => (
      <>
        <li aria-hidden="true" style="color: var(--color-border);">/</li>
        <li>
          {item.href && i < items.length - 1
            ? <a href={item.href} class="hover:text-[var(--color-body)] transition-colors">{item.label}</a>
            : <span style="color: var(--color-body);" aria-current="page">{item.label}</span>
          }
        </li>
      </>
    ))}
  </ol>
</nav>
