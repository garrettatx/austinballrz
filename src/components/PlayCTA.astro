---
/**
 * PlayCTA — lightweight "Want to play?" call-to-action banner.
 * Drop on any page before PhotoRow to drive people to the contact page.
 */
---

<section class="section-sm">
  <div class="container">
    <div class="fade-in" style={`border-left: 4px solid var(--color-accent); padding-left: var(--space-6);`}>
      <p class="heading h4" style="margin-bottom: var(--space-2);">Want to Play?</p>
      <p style="margin-bottom: var(--space-3); color: var(--color-body);">All skill levels welcome. See seasons, divisions, and how to join — or send us a message.</p>
      <a href="/contact/" class="btn btn-primary">Player Info & Contact</a>
    </div>
  </div>
</section>
