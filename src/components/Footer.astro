---
import { site, allPages } from '../data/site';
---

<footer slot="footer">
  <div class="ballrz-rainbow footer-rainbow" aria-hidden="true"></div>

  <div class="footer-wrap">
    <div class="container section">
      <div class="grid grid-cols-1 sm:grid-cols-3 footer-grid">
        {/* Brand */}
        <div>
          <img
            src="/images/logo.svg"
            alt={site.name}
            width="250"
            height="180"
            class="footer-logo mb-3"
          />
          <p class="footer-tagline">{site.tagline}</p>
          <p class="footer-welcome">We welcome players of every sexual orientation, gender identity, gender expression, race, age, and ability.</p>
          <p class="footer-detail">Est. {site.founded} &middot; {site.location}</p>
          <p class="footer-detail footer-detail--tight">
            Games: Sundays at <a href="https://maps.google.com/?q=Krieg+Field+Austin+TX" class="footer-link underline">Krieg Field</a>
          </p>
        </div>

        {/* Links */}
        <div>
          <p class="footer-label">Explore</p>
          <ul class="footer-list">
            {allPages.map(item => (
              <li>
                <a href={item.href} class="footer-link">{item.label}</a>
              </li>
            ))}
          </ul>
        </div>

        {/* Connect */}
        <div>
          <p class="footer-label">League</p>
          <ul class="footer-list">
            <li><a href="https://www.softballaustin.org/" class="footer-link">Softball Austin</a></li>
            <li><a href="https://www.ipridesoftball.org/" class="footer-link">iPride Softball League</a></li>
            {site.social.facebook && (
              <li><a href={site.social.facebook} class="footer-link">Ball'rz on Facebook</a></li>
            )}
          </ul>

          <div class="footer-cta">
            <a href="/join/" class="btn footer-cta-btn">Come Play With Us</a>
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row justify-between items-center footer-bottom">
        <p>&copy; {new Date().getFullYear()} {site.name}</p>
        <p>
          Website by <a href="https://prideandprairie.com/" class="text-white/60 hover:text-white transition-colors">Pride &amp; Prairie</a>
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-rainbow {
    height: 4px;
  }
  .footer-wrap {
    background: var(--color-surface);
    color: rgba(255, 255, 255, 0.7);
  }
  .footer-grid {
    gap: var(--space-8);
  }
  .footer-logo {
    width: 250px;
    filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.3))
            drop-shadow(0 0 8px rgba(255, 255, 255, 0.15));
  }
  .footer-tagline {
    font-size: var(--text-base);
    line-height: 1.6;
  }
  .footer-welcome {
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-top: var(--space-2);
    color: rgba(255, 255, 255, 0.5);
  }
  .footer-detail {
    font-size: var(--text-base);
    margin-top: var(--space-2);
  }
  .footer-detail--tight {
    margin-top: var(--space-1);
  }
  .footer-label {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
    color: rgba(255, 255, 255, 0.4);
  }
  .footer-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer-link {
    font-size: var(--text-base);
    color: var(--color-nav-inactive);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-link:hover {
    color: white;
  }
  .footer-cta {
    margin-top: var(--space-6);
  }
  .footer-cta-btn {
    font-size: var(--text-base);
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent-light);
    color: #1a1a2e;
  }
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    gap: var(--space-4);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.4);
  }
</style>
