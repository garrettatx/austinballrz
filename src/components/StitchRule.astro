---
/**
 * StitchRule — softball stitching decorative divider.
 *
 * Usage:
 *   <StitchRule />              — section divider (centered, default)
 *   <StitchRule variant="hero" /> — hero underline (left-aligned, slightly lighter)
 */
interface Props {
  variant?: 'divider' | 'hero';
}

const { variant = 'divider' } = Astro.props;
const isHero = variant === 'hero';
---

<div style={`display: flex; justify-content: ${isHero ? 'flex-start' : 'center'}; padding-block: ${isHero ? '0' : 'var(--space-2)'};`}>
  <svg
    class="stitch-rule"
    style={`display: block; width: 180px; height: 16px; opacity: ${isHero ? '0.45' : '0.5'};`}
    viewBox="0 0 180 16"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M0,8 Q30,4 60,8 T120,8 T180,8" fill="none" stroke="var(--color-red)" stroke-width="3"/>
    <line x1="28" y1="1" x2="32" y2="15" stroke="var(--color-red)" stroke-width="2"/>
    <line x1="88" y1="1" x2="92" y2="15" stroke="var(--color-red)" stroke-width="2"/>
    <line x1="148" y1="1" x2="152" y2="15" stroke="var(--color-red)" stroke-width="2"/>
  </svg>
</div>
