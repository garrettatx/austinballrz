---
/**
 * StitchRule — softball seam decorative divider.
 * Wavy red seam line with stitch hash marks, centered between sections.
 */
---

<div style="display: flex; justify-content: center; padding-top: var(--space-3); padding-bottom: 0;">
  <svg
    style="display: block; width: 180px; height: 16px; opacity: 0.45;"
    viewBox="0 0 180 16"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M0,8 Q30,4 60,8 T120,8 T180,8" fill="none" stroke="var(--color-red)" stroke-width="2.5" stroke-linecap="round"/>
    <line x1="28" y1="1" x2="32" y2="15" stroke="var(--color-red)" stroke-width="2"/>
    <line x1="88" y1="1" x2="92" y2="15" stroke="var(--color-red)" stroke-width="2"/>
    <line x1="148" y1="1" x2="152" y2="15" stroke="var(--color-red)" stroke-width="2"/>
  </svg>
</div>
