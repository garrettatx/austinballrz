---
/**
 * StitchRule — softball seam decorative divider.
 * A gentle wavy line in softball red, centered between sections.
 */
---

<div style="display: flex; justify-content: center; padding-block: var(--space-2);">
  <svg
    style="display: block; width: 180px; height: 10px; opacity: 0.45;"
    viewBox="0 0 180 10"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M0,5 Q30,2 60,5 T120,5 T180,5" fill="none" stroke="var(--color-red)" stroke-width="2.5" stroke-linecap="round"/>
  </svg>
</div>
