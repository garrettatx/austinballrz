---
/**
 * AdminLayout — shared shell for all admin pages.
 * Provides branded header, rainbow bar, content slot, nav footer.
 * Does NOT include analytics, OG tags, or global.css.
 *
 * Reusable: swap site.name, navigation, and brand colors per site.
 */
import { site, navigation, allPages } from '../../data/site';

interface Props {
  title: string;
  maxWidth?: string;
}

const { title, maxWidth = '520px' } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | {site.name}</title>
  <meta name="robots" content="noindex, nofollow" />
  <style define:vars={{ maxWidth }}>
    @font-face { font-family: 'Barlow Condensed'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/barlow-condensed-700.woff2') format('woff2'); }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #ffffff; color: #1a1a2e; line-height: 1.6; min-height: 100dvh; display: flex; flex-direction: column; -webkit-text-size-adjust: 100%; }

    .admin-header { background: #263a5a; padding: 12px 20px; }
    .admin-header a { color: white; text-decoration: none; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 1.125rem; letter-spacing: 0.04em; text-transform: uppercase; }
    .admin-rainbow { height: 4px; background: linear-gradient(90deg, #D92638, #E08A00, #D4AD00, #3DA812, #1094D4, #6A2BE0); }

    .admin-page { padding: 20px 20px 32px; max-width: var(--maxWidth); margin: 0 auto; flex: 1; width: 100%; }

    .admin-footer { background: #263a5a; color: rgba(255,255,255,0.6); padding: 20px; margin-top: auto; }
    .admin-footer-inner { max-width: var(--maxWidth); margin: 0 auto; }
    .admin-footer nav { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-bottom: 12px; }
    .admin-footer a { font-size: 0.8rem; color: rgba(255,255,255,0.6); text-decoration: none; transition: color 0.15s; }
    .admin-footer a:hover { color: white; }
    .admin-footer .credit { font-size: 0.7rem; color: rgba(255,255,255,0.35); }

    /* Fade-in for dynamically loaded content */
    @keyframes adminFadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .admin-page { animation: adminFadeIn 0.25s ease-out; }

    @media (max-width: 380px) {
      .admin-page { padding: 16px 16px 24px; }
    }
  </style>
  <slot name="head" />
</head>
<body>
  <div class="admin-header">
    <a href={site.url}>{site.name}</a>
  </div>
  <div class="admin-rainbow" aria-hidden="true"></div>

  <div class="admin-page">
    <slot />
  </div>

  <footer class="admin-footer">
    <div class="admin-footer-inner">
      <nav>
        <a href={site.url}>Home</a>
        {navigation.map(item => (
          <a href={`${site.url}${item.href}`}>{item.label}</a>
        ))}
      </nav>
      <p class="credit">&copy; {currentYear} {site.name}</p>
    </div>
  </footer>
</body>
</html>
