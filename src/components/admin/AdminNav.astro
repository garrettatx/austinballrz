---
/**
 * AdminNav — navigation between admin tools.
 * Shows public and protected tools with visual distinction.
 */
interface Tool {
  label: string;
  href: string;
  protected?: boolean;
}

interface Props {
  tools?: Tool[];
  current?: string;
}

const defaultTools: Tool[] = [
  { label: 'Admin', href: '/admin/' },
  { label: 'Submit Photo', href: '/admin/photo/' },
  { label: 'Photo Review', href: '/admin/dashboard/photos/', protected: true },
  { label: 'Messages', href: '/admin/dashboard/messages/', protected: true },
];

const { tools = defaultTools, current } = Astro.props;
---

<nav class="admin-nav">
  {tools.map(tool => {
    const isActive = current === tool.href;
    return (
      <a
        href={tool.href}
        class:list={['admin-nav-pill', { active: isActive }]}
        data-nav-href={tool.href}
      >
        {tool.protected && !isActive ? <span aria-hidden="true" class="lock-icon">&#x1f512; </span> : ''}{tool.label}<span class="admin-nav-badge" data-badge-for={tool.href}></span>
      </a>
    );
  })}
</nav>

<script is:inline>
(function() {
  function setBadge(href, count) {
    if (!count) return;
    document.querySelectorAll('[data-badge-for="' + href + '"]').forEach(function(el) {
      el.textContent = count;
      el.style.display = '';
    });
  }

  // Fetch unread messages count
  fetch('/api/admin/messages/').then(function(r) { return r.json(); }).then(function(data) {
    var msgs = data.messages || [];
    var unread = msgs.filter(function(m) { return !m.read; }).length;
    setBadge('/admin/dashboard/messages/', unread);
    // Also update dashboard card if present
    var msgCard = document.querySelector('[data-dash-card="messages"]');
    if (msgCard && unread) msgCard.querySelector('.dash-card-desc').textContent = unread + ' unread message' + (unread === 1 ? '' : 's');
  }).catch(function() {});

  // Fetch pending photos count
  fetch('/api/admin/photos/').then(function(r) { return r.json(); }).then(function(data) {
    var pending = (data.pending || []).length;
    setBadge('/admin/dashboard/photos/', pending);
    var photoCard = document.querySelector('[data-dash-card="photos"]');
    if (photoCard && pending) photoCard.querySelector('.dash-card-desc').textContent = pending + ' pending review';
  }).catch(function() {});
})();
</script>

<style>
  .admin-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .admin-nav-pill {
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    padding: 4px 12px;
    border-radius: 100px;
    transition: background 0.15s, color 0.15s;
    background: #f0f0f4;
    color: #475569;
  }
  .admin-nav-pill:hover {
    background: #e2e2e6;
    color: #1a1a2e;
  }
  .admin-nav-pill.active {
    background: #42168A;
    color: white;
  }
  .admin-nav-pill.active:hover {
    background: #42168A;
    color: white;
  }
  .lock-icon {
    font-size: 0.625rem;
  }
  .admin-nav-badge {
    display: none;
    font-size: 0.625rem;
    font-weight: 700;
    background: #dc2626;
    color: white;
    min-width: 16px;
    height: 16px;
    line-height: 16px;
    text-align: center;
    border-radius: 100px;
    margin-left: 4px;
    padding: 0 4px;
    vertical-align: middle;
  }
  .admin-nav-pill.active .admin-nav-badge {
    background: white;
    color: #42168A;
  }
</style>
