---
/**
 * AdminNav — navigation between admin tools.
 * Shows public and protected tools with visual distinction.
 */
interface Tool {
  label: string;
  href: string;
  protected?: boolean;
}

interface Props {
  tools?: Tool[];
  current?: string;
}

const defaultTools: Tool[] = [
  { label: 'Admin', href: '/admin/' },
  { label: 'Submit Photo', href: '/admin/photo/' },
  { label: 'Messages', href: '/admin/dashboard/messages/', protected: true },
  { label: 'Photo Review', href: '/admin/dashboard/photos/', protected: true },
];

const { tools = defaultTools, current } = Astro.props;
---

<nav class="admin-nav">
  {tools.map(tool => {
    const isActive = current === tool.href;
    return (
      <a
        href={tool.href}
        class:list={['admin-nav-pill', { active: isActive }]}
      >
        {tool.protected && !isActive ? <span aria-hidden="true" class="lock-icon">&#x1f512; </span> : ''}{tool.label}
      </a>
    );
  })}
</nav>

<style>
  .admin-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .admin-nav-pill {
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    padding: 4px 12px;
    border-radius: 100px;
    transition: background 0.15s, color 0.15s;
    background: #f0f0f4;
    color: #475569;
  }
  .admin-nav-pill:hover {
    background: #e2e2e6;
    color: #1a1a2e;
  }
  .admin-nav-pill.active {
    background: #42168A;
    color: white;
  }
  .admin-nav-pill.active:hover {
    background: #42168A;
    color: white;
  }
  .lock-icon {
    font-size: 0.625rem;
  }
</style>
