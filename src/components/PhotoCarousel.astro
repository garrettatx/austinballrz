---
/**
 * PhotoCarousel — lightweight, scroll-snap carousel with optional arrows.
 *
 * Uses CSS scroll-snap for native swipe on mobile and smooth behavior on desktop.
 * Arrows are optional progressive enhancement (JS) — carousel works without JS.
 *
 * Props:
 *   photos   — array of { src, alt, caption? }
 *   label    — optional section label above the carousel (e.g. "Photos")
 *   linkHref — optional "View All" link
 *   linkText — text for the link (defaults to "View All Photos")
 */
import type { Photo } from '../data/photos';

interface Props {
  photos: Photo[];
  label?: string;
  linkHref?: string;
  linkText?: string;
}

const { photos, label, linkHref, linkText = 'View All Photos' } = Astro.props;
const carouselId = `carousel-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="photo-carousel-wrapper">
  {label && (
    <div class="flex items-center justify-between mb-3">
      <p class="label">{label}</p>
      {linkHref && <a href={linkHref} class="link-accent">{linkText} &rarr;</a>}
    </div>
  )}

  <div class="photo-carousel-container">
    {/* Previous arrow */}
    <button
      class="carousel-arrow carousel-arrow--prev"
      data-carousel={carouselId}
      data-dir="prev"
      aria-label="Previous photos"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M13 4L7 10L13 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    {/* Scrollable track */}
    <div class="photo-carousel" id={carouselId}>
      {photos.map(photo => (
        <div class="photo-carousel-slide">
          <button class="photo-carousel-img-btn photo-open" data-src={photo.src} data-alt={photo.alt}>
            <img
              src={photo.src}
              alt={photo.alt}
              class="photo-carousel-img"
              loading="lazy"
            />
          </button>
          {photo.caption && (
            <p class="photo-carousel-caption">{photo.caption}</p>
          )}
        </div>
      ))}
    </div>

    {/* Next arrow */}
    <button
      class="carousel-arrow carousel-arrow--next"
      data-carousel={carouselId}
      data-dir="next"
      aria-label="Next photos"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M7 4L13 10L7 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .photo-carousel-wrapper {
    position: relative;
  }

  .photo-carousel-container {
    position: relative;
  }

  .photo-carousel {
    display: flex;
    gap: var(--space-3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
    padding-block: var(--space-1);
  }
  .photo-carousel::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }

  .photo-carousel-slide {
    flex: 0 0 auto;
    width: 280px;
    scroll-snap-align: start;
  }
  @media (min-width: 768px) {
    .photo-carousel-slide {
      width: 320px;
    }
  }

  .photo-carousel-img-btn {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 0.5rem;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .photo-carousel-img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .photo-carousel-img-btn:hover .photo-carousel-img {
    transform: scale(1.04);
  }

  .photo-carousel-caption {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-top: var(--space-2);
  }

  /* Arrows */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--color-border);
    color: var(--color-body);
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    transition: opacity 0.2s, background 0.2s;
    opacity: 0;
  }
  .photo-carousel-container:hover .carousel-arrow {
    opacity: 1;
  }
  /* Always show on touch devices (no hover) */
  @media (hover: none) {
    .carousel-arrow {
      opacity: 0.85;
    }
  }
  .carousel-arrow:hover {
    background: white;
  }
  .carousel-arrow--prev {
    left: var(--space-2);
  }
  .carousel-arrow--next {
    right: var(--space-2);
  }
  .carousel-arrow[disabled] {
    opacity: 0.3;
    cursor: default;
  }
</style>

<script is:inline>
(function() {
  if (window.__carouselInit) return;
  window.__carouselInit = true;

  document.addEventListener('click', function(e) {
    var btn = e.target.closest('.carousel-arrow');
    if (!btn) return;

    var id = btn.getAttribute('data-carousel');
    var dir = btn.getAttribute('data-dir');
    var track = document.getElementById(id);
    if (!track) return;

    var slide = track.querySelector('.photo-carousel-slide');
    if (!slide) return;

    var scrollAmount = slide.offsetWidth + 12; // slide width + gap
    track.scrollBy({
      left: dir === 'next' ? scrollAmount : -scrollAmount,
      behavior: 'smooth'
    });
  });
})();
</script>
