---
/**
 * Inner page header — consistent across all inner pages.
 * Pattern: breadcrumb → heading → optional description
 */
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  breadcrumbs: { label: string; href?: string }[];
}

const { title, description, breadcrumbs } = Astro.props;
---

<div class="max-w-5xl mx-auto px-6 pt-6 pb-8">
  <Breadcrumbs items={breadcrumbs} />
  <h1 class="text-2xl md:text-3xl font-bold text-[var(--ballrz-dark)]" style="font-family: var(--font-heading);">
    {title}
  </h1>
  {description && (
    <p class="text-[var(--ballrz-gray-600)] mt-2 text-[0.95rem] max-w-2xl">{description}</p>
  )}
</div>
