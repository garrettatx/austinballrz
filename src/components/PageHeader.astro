---
/**
 * Inner page header — consistent across all inner pages.
 * Uses design tokens. Pattern: breadcrumb → heading → optional description.
 */
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  breadcrumbs: { label: string; href?: string }[];
}

const { title, description, breadcrumbs } = Astro.props;
---

<div class="container" style={`padding-top: var(--space-6); padding-bottom: var(--space-8);`}>
  <Breadcrumbs items={breadcrumbs} />
  <h1 class="heading" style={`font-size: var(--text-xl); font-weight: 700;`}>
    {title}
  </h1>
  {description && (
    <p class="prose-width" style={`color: var(--color-body); margin-top: var(--space-2); font-size: var(--text-base);`}>
      {description}
    </p>
  )}
</div>

<style>
  @media (min-width: 768px) {
    h1 { font-size: var(--text-2xl) !important; }
  }
</style>
