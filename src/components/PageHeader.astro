---
/**
 * Inner page header — consistent across all inner pages.
 * Pattern: breadcrumb → h1 → optional description.
 * Uses .h2 size class (inner pages are subordinate to homepage hero).
 */
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  breadcrumbs: { label: string; href?: string }[];
}

const { title, description, breadcrumbs } = Astro.props;
---

<div class="container" style={`padding-top: var(--space-6); padding-bottom: var(--space-8);`}>
  <Breadcrumbs items={breadcrumbs} />
  <h1 class="heading h2">{title}</h1>
  {description && (
    <p class="prose-width" style={`margin-top: var(--space-2);`}>{description}</p>
  )}
</div>
