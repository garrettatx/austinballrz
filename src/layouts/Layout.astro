---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  jsonLd?: object | object[];
}

const { title, description = site.description, ogType = 'website', jsonLd } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ga4Id = 'G-LEV5K76WRK';
---

<!--

     ███████████
      █████████
       ███████
        █████
         ███
          █

     Built by Pride & Prairie
     prideandprairie.com

-->
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl.href} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl.href} />
  <meta property="og:site_name" content={site.name} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />


  <!-- Structured data -->
  {jsonLd && (
    Array.isArray(jsonLd)
      ? jsonLd.map(schema => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)
      : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Per-page head injection -->
  <slot name="head" />

  <!-- GA4 — deferred until first interaction or 3s -->
  <script is:inline define:vars={{ ga4Id }}>
    (function(){
      var d=false;
      function g(){
        if(d)return;d=true;clearTimeout(t);
        window.dataLayer=window.dataLayer||[];
        function gtag(){window.dataLayer.push(arguments);}
        window.gtag=gtag;
        gtag('js',new Date());
        gtag('config',ga4Id,{send_page_view:true});
        var f=document.createElement('script');
        f.async=true;f.src='https://www.googletagmanager.com/gtag/js?id='+ga4Id;
        document.head.appendChild(f);
        e.forEach(function(v){document.removeEventListener(v,g,true);});
      }
      var e=['scroll','click','keydown','touchstart','mousemove'];
      e.forEach(function(v){document.addEventListener(v,g,{capture:true,once:true,passive:true});});
      var t=setTimeout(g,3000);
    })();
  </script>
</head>
<body>

  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:rounded focus:shadow-lg focus:text-sm focus:font-semibold">
    Skip to content
  </a>

  <slot name="header" />

  <main id="main-content">
    <slot />
  </main>

  <slot name="footer" />

  <!-- Analytics events (navigation, clicks, conversions) -->
  <script>
    import '../scripts/analytics';
  </script>

</body>
</html>
