---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'History' }];
---

<Layout
  title={`History | ${site.name}`}
  description="The history of the Austin Ball'rz LGBTQ+ softball team, from our founding as the Austin Aardvarks in 2013 to World Series competition."
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="History of the Austin Ball'rz"
    description="From the Austin Aardvarks to World Series competitors."
    breadcrumbs={breadcrumbs}
  />

  <section class="pb-12">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-2xl space-y-8">

        <div>
          <h2 class="text-lg font-bold text-[var(--ballrz-dark)] mb-2" style="font-family: var(--font-heading);">Formation & Rebranding</h2>
          <p class="text-[var(--ballrz-gray-600)] leading-relaxed text-[0.95rem]">
            In the spring of 2013, the Austin Ball'rz played their first season as the Austin Aardvarks in the Softball Austin league. In 2014, we rebranded and became the Austin Ball'rz.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-[var(--ballrz-dark)] mb-2" style="font-family: var(--font-heading);">Rating Changes & Growth</h2>
          <p class="text-[var(--ballrz-gray-600)] leading-relaxed text-[0.95rem]">
            In 2019, we embraced iPride and Softball Austin's new skills rating system and created two teams: the D'Ball'rz (D division) and the EZ Ball'rz (E division). We became the first and only team in Softball Austin to compete in the E division.
          </p>
        </div>

        <div>
          <h2 class="text-lg font-bold text-[var(--ballrz-dark)] mb-2" style="font-family: var(--font-heading);">World Series</h2>
          <div class="space-y-3 text-[var(--ballrz-gray-600)] leading-relaxed text-[0.95rem]">
            <p><strong class="text-[var(--ballrz-dark)]">2019</strong> — Both teams earned bids to the NAGAAA World Series in Kansas City. The EZ Ball'rz finished 4th, bringing home a trophy and individual medals. The D'Ball'rz won their division in the fall.</p>
            <p><strong class="text-[var(--ballrz-dark)]">2020</strong> — Welcomed the Blue Ball'rz (second E team). Season interrupted by COVID-19.</p>
            <p><strong class="text-[var(--ballrz-dark)]">2021</strong> — EZ Ball'rz returned to the GSWS in Columbus, finishing 13th out of 30 teams.</p>
            <p><strong class="text-[var(--ballrz-dark)]">2022</strong> — Consolidated to a single EZ Ball'rz team. Finished 13th of 33 teams at the GSWS in Dallas.</p>
            <p><strong class="text-[var(--ballrz-dark)]">2023</strong> — Competed at the iPride World Series in Minneapolis.</p>
            <p><strong class="text-[var(--ballrz-dark)]">2024</strong> — Competed at the iPride World Series in Las Vegas.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <section class="py-8 bg-[var(--ballrz-gray-50)]">
    <div class="max-w-5xl mx-auto px-6">
      <p class="text-xs uppercase tracking-widest text-[var(--ballrz-gray-400)] mb-3" style="font-family: var(--font-heading);">Through the Years</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
        <div class="aspect-[4/3] overflow-hidden rounded-lg"><img src="/images/team/team-2023.jpg" alt="Ball'rz 2023" class="w-full h-full object-cover" loading="lazy" /></div>
        <div class="aspect-[4/3] overflow-hidden rounded-lg"><img src="/images/team/team-2022.jpg" alt="Ball'rz 2022" class="w-full h-full object-cover" loading="lazy" /></div>
        <div class="aspect-[4/3] overflow-hidden rounded-lg"><img src="/images/team/team-2021.jpg" alt="Ball'rz 2021" class="w-full h-full object-cover" loading="lazy" /></div>
        <div class="aspect-[4/3] overflow-hidden rounded-lg"><img src="/images/team/team-2019.jpg" alt="Ball'rz 2019" class="w-full h-full object-cover" loading="lazy" /></div>
      </div>
      <p class="mt-2"><a href="/photos/" class="text-xs font-semibold text-[var(--ballrz-purple)] hover:underline" style="font-family: var(--font-heading);">View All Photos &rarr;</a></p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
