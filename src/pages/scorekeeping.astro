---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Scorekeeping in Softball' }];
---

<Layout
  title={`Scorekeeping in Softball | ${site.name}`}
  description="Learn how to keep score at Softball Austin games."
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Scorekeeping in Softball"
    breadcrumbs={breadcrumbs}
  />

  <section class="pb-12">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-2xl">
        <p class="text-[var(--ballrz-gray-600)] text-[0.95rem]">Content being migrated. Check back soon.</p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
