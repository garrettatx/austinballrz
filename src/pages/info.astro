---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Your Guide to NAGAAA Softball' }];
---

<Layout
  title={`Your Guide to NAGAAA Softball | ${site.name}`}
  description="Everything you need to know about playing NAGAAA softball."
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Your Guide to NAGAAA Softball"
    breadcrumbs={breadcrumbs}
  />

  <section class="pb-12">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-2xl">
        <p class="text-[var(--color-body)] ">This page is on its way. Hang tight.</p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
