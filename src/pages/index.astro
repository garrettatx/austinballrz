---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoModal from '../components/PhotoModal.astro';
import { site } from '../data/site';
import { organizationSchema } from '../lib/schema';
---

<Layout
  title={`${site.name} — ${site.tagline}`}
  jsonLd={organizationSchema()}
>
  <Header slot="header" />

  {/* ── Hero ── */}
  <section>
    <div class="container" style={`padding-block: var(--space-8);`}>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] items-center" style={`gap: var(--space-8);`}>

        <div>
          <h1 class="heading h1" style={`margin-bottom: var(--space-3);`}>
            PLAY BOLD, <span style="color: var(--color-accent);">PLAY PROUD.</span>
          </h1>
          <p class="prose-width" style={`margin-bottom: var(--space-6);`}>
            We're an LGBTQ+ softball team in Austin, Texas. Since 2013, we've been showing up to play hard, have fun, and make room for everybody. All skill levels, all backgrounds, all welcome.
          </p>
          <div class="flex items-center flex-wrap" style={`gap: var(--space-3);`}>
            <a href="/contact/" class="btn btn-primary">Come Play With Us</a>
            <a href="/history/" class="btn btn-secondary">See Our Story</a>
          </div>
        </div>

        <div class="relative">
          <div class="absolute w-full h-full rounded-xl hidden lg:block" style={`top: var(--space-2); left: var(--space-2); background: var(--color-accent); opacity: 0.12;`} aria-hidden="true"></div>
          <div class="relative rounded-xl overflow-hidden shadow-lg">
            <img
              src="/images/team/gsws-2023.jpg"
              alt="Austin Ball'rz at the Gay Softball World Series in Minneapolis, 2023"
              class="w-full h-auto"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* ── About ── */}
  <section class="section-sm" style="background: var(--color-bg-alt);">
    <div class="container">
      <div class="prose-width">
        <h2 class="heading h3" style={`margin-bottom: var(--space-3);`}>About Us</h2>
        <p>
          We play in Softball Austin, part of the iPride Softball League, and have since 2013. We started as the Austin Aardvarks, became the Ball'rz in 2014, and it stuck. We play league ball, travel to tournaments, and have competed in the Gay Softball World Series five times.
        </p>
      </div>
    </div>
  </section>

  {/* ── Photos ── */}
  <section class="section-sm">
    <div class="container">
      <p class="label" style={`margin-bottom: var(--space-3);`}>Photos</p>
      <div class="grid grid-cols-2 md:grid-cols-4" style={`gap: var(--space-2);`}>
        <button class="aspect-[4/3] overflow-hidden rounded-lg cursor-pointer photo-open" data-src="/images/team/team-2023.jpg" data-alt="Austin Ball'rz 2023 team photo on the field">
          <img src="/images/team/team-2023.jpg" alt="Austin Ball'rz 2023 team photo on the field" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
        </button>
        <button class="aspect-[4/3] overflow-hidden rounded-lg cursor-pointer photo-open" data-src="/images/team/team-2022.jpg" data-alt="Austin Ball'rz Fall 2022 team photo">
          <img src="/images/team/team-2022.jpg" alt="Austin Ball'rz Fall 2022 team photo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
        </button>
        <button class="aspect-[4/3] overflow-hidden rounded-lg cursor-pointer photo-open" data-src="/images/team/gsws-2023.jpg" data-alt="Austin Ball'rz at the Gay Softball World Series in Minneapolis, 2023">
          <img src="/images/team/gsws-2023.jpg" alt="Austin Ball'rz at the Gay Softball World Series in Minneapolis, 2023" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
        </button>
        <button class="aspect-[4/3] overflow-hidden rounded-lg cursor-pointer photo-open" data-src="/images/team/team-2019.jpg" data-alt="Austin Ball'rz 2019 team photo">
          <img src="/images/team/team-2019.jpg" alt="Austin Ball'rz 2019 team photo" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
        </button>
      </div>
      <p style={`margin-top: var(--space-3);`}><a href="/photos/" class="link-accent">View All Photos &rarr;</a></p>
    </div>
  </section>

  <PhotoModal />

  {/* ── Mission ── */}
  <section class="section-sm">
    <div class="container">
      <div class="prose-width">
        <div style={`border-left: 4px solid var(--color-accent); padding-left: var(--space-6);`}>
          <h2 class="heading h3" style={`margin-bottom: var(--space-3);`}>Our Mission</h2>
          <p style={`margin-bottom: var(--space-4);`}>
            Softball is for everyone. We play with people of all ages, races, genders, and skill levels. Never swung a bat? Been playing for years? Either way, there's a spot for you.
          </p>
          <a href="/contact/" class="link-accent">Want to play? Reach out &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Come Play ── */}
  <section class="section-sm" style="background: var(--color-bg-alt);">
    <div class="container">
      <h2 class="heading h3" style={`margin-bottom: var(--space-6);`}>Come Play</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2" style={`gap: var(--space-8);`}>

        <div class="prose-width">
          <h3 class="heading h4" style={`margin-bottom: var(--space-2);`}>Two Seasons, Two Skill Levels</h3>
          <p style={`margin-bottom: var(--space-3);`}>
            We play spring and fall seasons in the Softball Austin league. Games are on Sundays at <a href="https://maps.google.com/?q=Krieg+Field+Austin+TX" class="text-[var(--color-accent)] hover:underline">Krieg Field</a> in Austin.
          </p>
          <ul style={`display: flex; flex-direction: column; gap: var(--space-2); padding-left: var(--space-6); margin-bottom: var(--space-3);`} class="list-disc">
            <li><strong>D Division</strong> — for players with more experience.</li>
            <li><strong>E Division</strong> — for newer players or those still building their game. No experience needed. We're all learning and growing together.</li>
          </ul>
          <p>
            We practice on weeknights during the spring season at Krieg Field or Southeast Metro Field in Del Valle. Fall is more casual — no practices, just Sunday games.
          </p>
        </div>

        <div class="prose-width">
          <h3 class="heading h4" style={`margin-bottom: var(--space-2);`}>How to Join</h3>
          <p style={`margin-bottom: var(--space-3);`}>
            Reach out and one of our coaches will walk you through it. You'll register through Softball Austin — it's a straightforward process. There's a league registration fee and a team fee that covers practice fields, jerseys, and gear.
          </p>

          <h3 class="heading h4" style={`margin-bottom: var(--space-2); margin-top: var(--space-6);`}>More Than Games</h3>
          <p style={`margin-bottom: var(--space-4);`}>
            We do social events outside of Sunday games too. It's a great way to meet people and be part of a community — no bar required.
          </p>
          <a href="/contact/" class="btn btn-primary">Get in Touch</a>
        </div>

      </div>
    </div>
  </section>

  {/* ── Achievements — scoreboard ── */}
  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <h2 class="heading h3 text-center" style={`color: rgba(255,255,255,0.9); margin-bottom: var(--space-6);`}>On the Field</h2>
      <div class="content-width mx-auto">
        <div class="rounded-xl" style={`background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); padding: var(--space-1);`}>
          <div class="grid grid-cols-3 divide-x divide-white/8">
            <div class="text-center" style={`padding-block: var(--space-6);`}>
              <p class="heading" style={`font-size: var(--text-stat); font-weight: 700; color: var(--color-scoreboard); text-shadow: 0 0 20px rgba(74,222,128,0.15);`}>5</p>
              <p class="label" style={`color: var(--color-nav-inactive); margin-top: var(--space-2);`}>World Series</p>
            </div>
            <div class="text-center" style={`padding-block: var(--space-6);`}>
              <p class="heading" style={`font-size: var(--text-stat); font-weight: 700; color: var(--color-scoreboard); text-shadow: 0 0 20px rgba(74,222,128,0.15);`}>4th</p>
              <p class="label" style={`color: var(--color-nav-inactive); margin-top: var(--space-2);`}>Best Finish '19</p>
            </div>
            <div class="text-center" style={`padding-block: var(--space-6);`}>
              <p class="heading" style={`font-size: var(--text-stat); font-weight: 700; color: var(--color-scoreboard); text-shadow: 0 0 20px rgba(74,222,128,0.15);`}>2013</p>
              <p class="label" style={`color: var(--color-nav-inactive); margin-top: var(--space-2);`}>Founded</p>
            </div>
          </div>
        </div>
      </div>
      <p class="text-center" style={`margin-top: var(--space-4);`}>
        <a href="/achievements/" class="link-accent uppercase" style="color: var(--color-accent-light); letter-spacing: 0.06em;">
          View All Achievements &rarr;
        </a>
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

