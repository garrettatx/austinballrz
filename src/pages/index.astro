---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhotoRow from '../components/PhotoRow.astro';
import WaveEdge from '../components/WaveEdge.astro';
import { site } from '../data/site';
import { playing } from '../data/playing';
import { heroPhotos } from '../data/photos';
import { organizationSchema } from '../lib/schema';
---

<Layout
  title={`${site.name} — ${site.tagline}`}
  description="LGBTQ+ inclusive softball in Austin, TX. Two seasons a year, all skill levels welcome. Playing since 2013."
  jsonLd={organizationSchema()}
>
  <Header slot="header" />

  {/* ── Hero ── */}
  <section>
    <div class="container" style={`padding-block: var(--space-8);`}>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] items-center" style={`gap: var(--space-8);`}>

        <div class="fade-in">
          <h1 class="heading h1 mb-3">
            PLAY BOLD, <span style="color: var(--color-accent);">PLAY PROUD.</span>
          </h1>
          <p class="prose-width" style={`margin-bottom: var(--space-6);`}>
            We're an LGBTQ+ softball team in Austin, Texas. Since 2013, we've been showing up to play hard, have fun, and make room for everybody. All skill levels, all backgrounds, all welcome.
          </p>
          <div class="flex items-center flex-wrap" style={`gap: var(--space-3);`}>
            <a href="/contact/" class="btn btn-primary">Come Play With Us</a>
            <a href="/history/" class="btn btn-secondary">See Our Story</a>
          </div>
        </div>

        <div class="relative fade-in" style="transition-delay: 0.15s;">
          <div class="absolute w-full h-full rounded-xl hidden lg:block" style={`top: var(--space-2); left: var(--space-2); background: var(--color-accent); opacity: 0.12;`} aria-hidden="true"></div>
          <div class="relative rounded-xl overflow-hidden shadow-lg">
            <img
              id="hero-photo"
              src={heroPhotos[0].src}
              alt={heroPhotos[0].alt}
              class="w-full h-auto"
              loading="eager"
              fetchpriority="high"
              data-heroes={JSON.stringify(heroPhotos.map(p => ({ src: p.src, alt: p.alt })))}
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* ── About ── */}
  <WaveEdge from="white" to="alt" />
  <section class="section-sm bg-alt">
    <div class="container">
      <div class="prose-width fade-in">
        <h2 class="heading h3 mb-3">About Us</h2>
        <p>
          We play in Softball Austin, part of the iPride Softball League, and have since 2013. We started as the Austin Aardvarks, became the Ball'rz in 2014, and it stuck. We play league ball, travel to tournaments, and have competed in the Gay Softball World Series five times.
        </p>
      </div>
    </div>
  </section>
  <WaveEdge from="alt" to="white" />

  {/* ── Photos ── */}
  <PhotoRow />

  {/* ── Mission ── */}
  <section class="section-sm">
    <div class="container">
      <div class="prose-width fade-in">
        <div>
          <h2 class="heading h3 mb-3">Our Mission</h2>
          <p style={`margin-bottom: var(--space-4);`}>
            Softball is for everyone. We play with people of all ages, races, genders, and skill levels. Never swung a bat? Been playing for years? Either way, there's a spot for you.
          </p>
          <a href="/contact/" class="link-accent" style="font-size: var(--text-base);">Want to play? Reach out &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Come Play ── */}
  <WaveEdge from="white" to="alt" />
  <section class="section-sm bg-alt">
    <div class="container">
      <h2 class="heading h3 fade-in" style={`margin-bottom: var(--space-6);`}>Come Play</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 stagger" style={`gap: var(--space-8);`}>

        <div class="prose-width fade-in">
          <h3 class="heading h4" style={`margin-bottom: var(--space-2);`}>Two Seasons, Two Skill Levels</h3>
          <p class="mb-3">
            We play spring and fall seasons in the {playing.league} league. {playing.gameDay} Games are at <a href={playing.fieldUrl} class="text-[var(--color-accent)] hover:underline">{playing.field}</a> in {playing.fieldCity}.
          </p>
          <ul class="list-spaced mb-3">
            {playing.divisions.map(div => (
              <li><strong>{div.name}</strong> — {div.description}</li>
            ))}
          </ul>
          <p>
            {playing.practiceNote}
          </p>
        </div>

        <div class="prose-width fade-in">
          <h3 class="heading h4" style={`margin-bottom: var(--space-2);`}>How to Join</h3>
          <p class="mb-3">
            {playing.joiningNote}
          </p>

          <h3 class="heading h4" style={`margin-bottom: var(--space-2); margin-top: var(--space-6);`}>More Than Games</h3>
          <p style={`margin-bottom: var(--space-4);`}>
            {playing.socialNote}
          </p>
          <a href="/contact/#contact-form-top" class="btn btn-primary">Get in Touch</a>
        </div>

      </div>
    </div>
  </section>

  {/* ── Achievements — scoreboard ── */}
  <WaveEdge from="alt" to="white" />
  <section class="section">
    <div class="container">
      <h2 class="heading h3 text-center mb-6 fade-in">On the Field</h2>
      <div class="content-width mx-auto fade-in" style="transition-delay: 0.1s;">
        <div class="rounded-xl" style={`background: var(--color-surface); padding: var(--space-1);`}>
          <div class="grid grid-cols-3 divide-x divide-white/10 stagger">
            <div class="text-center fade-in" style={`padding-block: var(--space-8);`}>
              <p class="scoreboard-stat" style="color: var(--color-scoreboard);">5</p>
              <p class="scoreboard-label mt-2" style="color: rgba(255,255,255,0.85);">World Series Trips</p>
            </div>
            <div class="text-center fade-in" style={`padding-block: var(--space-8);`}>
              <p class="scoreboard-stat" style="color: var(--color-scoreboard);">4th Pl.</p>
              <p class="scoreboard-label mt-2" style="color: rgba(255,255,255,0.85);">2019 World Series</p>
            </div>
            <div class="text-center fade-in" style={`padding-block: var(--space-8);`}>
              <p class="scoreboard-stat" style="color: var(--color-scoreboard);">2013</p>
              <p class="scoreboard-label mt-2" style="color: rgba(255,255,255,0.85);">Founded</p>
            </div>
          </div>
        </div>
      </div>
      <p class="text-center mt-4 fade-in">
        <a href="/achievements/" class="link-accent" style="font-size: var(--text-base);">View All Achievements &rarr;</a>
      </p>
    </div>
  </section>

  {/* Hero rotation — if multiple hero photos exist, pick one randomly each load */}
  <script is:inline>
  (function() {
    var img = document.getElementById('hero-photo');
    if (!img) return;
    try {
      var heroes = JSON.parse(img.getAttribute('data-heroes'));
      if (heroes.length > 1) {
        var pick = heroes[Math.floor(Math.random() * heroes.length)];
        img.src = pick.src;
        img.alt = pick.alt;
      }
    } catch(e) {}
  })();
  </script>

  <Footer slot="footer" />
</Layout>
