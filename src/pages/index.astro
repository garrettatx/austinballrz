---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { organizationSchema } from '../lib/schema';
---

<Layout
  title={`${site.name} — ${site.tagline}`}
  jsonLd={organizationSchema()}
>
  <Header slot="header" />

  <!-- Hero — tight, logo-forward, team photo -->
  <section class="bg-white relative overflow-hidden">
    <!-- Subtle diamond watermark positioned behind content -->
    <img src="/images/diamond-field.svg" alt="" aria-hidden="true" class="absolute right-0 top-0 w-80 h-80 opacity-40 pointer-events-none select-none" style="transform: translate(30%, -10%);" />

    <div class="max-w-5xl mx-auto px-6 pt-10 pb-12 md:pt-12 md:pb-14 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10 items-center">

        <div>
          <img
            src="/images/logo.svg"
            alt="Austin Ball'rz logo"
            width="240"
            height="170"
            class="w-44 md:w-52 mb-5"
          />
          <h1 class="text-3xl md:text-4xl font-bold leading-tight text-[var(--ballrz-dark)] mb-3" style="font-family: var(--font-heading);">
            PLAY BOLD,
            <span class="text-[var(--ballrz-purple)]">PLAY PROUD.</span>
          </h1>
          <p class="text-[var(--ballrz-gray-600)] leading-relaxed mb-5 text-[0.95rem] max-w-[22rem]">
            LGBTQ+ inclusive softball in Austin, TX. Since 2013, we've built a team where everyone belongs — on the field and off.
          </p>
          <div class="flex items-center gap-3 flex-wrap">
            <a href="/history/" class="px-5 py-2.5 bg-[var(--ballrz-purple)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--ballrz-purple-dark)] transition-colors" style="font-family: var(--font-heading); letter-spacing: 0.04em;">
              Our Story
            </a>
            <a href="/contact/" class="px-5 py-2.5 border-2 border-[var(--ballrz-gray-200)] text-[var(--ballrz-gray-600)] text-sm font-semibold rounded-lg hover:border-[var(--ballrz-purple)] hover:text-[var(--ballrz-purple)] transition-colors" style="font-family: var(--font-heading); letter-spacing: 0.04em;">
              Get in Touch
            </a>
          </div>
        </div>

        <div class="rounded-xl overflow-hidden aspect-[16/10] shadow-lg">
          <img
            src="/images/team/team-2023.jpg"
            alt="Austin Ball'rz 2023 team photo"
            class="w-full h-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>

    <!-- Stitch divider -->
    <div class="max-w-5xl mx-auto px-6">
      <svg viewBox="0 0 800 20" class="w-full h-5" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,10 Q200,0 400,10 T800,10" fill="none" stroke="#42168A" stroke-width="1.5" opacity="0.1" />
        <path d="M0,10 Q200,20 400,10 T800,10" fill="none" stroke="#42168A" stroke-width="1.5" opacity="0.1" />
      </svg>
    </div>
  </section>

  <!-- About -->
  <section class="py-12 bg-[var(--ballrz-gray-50)]">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-xl font-bold text-[var(--ballrz-dark)] mb-3 text-center" style="font-family: var(--font-heading); letter-spacing: 0.03em;">About Us</h2>
      <p class="text-[var(--ballrz-gray-600)] leading-relaxed text-center text-[0.95rem]">
        Since our founding in 2013, the Austin Ball'rz have become a vibrant part of Softball Austin. Originally named the Austin Aardvarks, we rebranded in 2014 and haven't looked back. We compete in league play and travel to regional and national tournaments — including multiple iPride World Series appearances.
      </p>
    </div>
  </section>

  <!-- Photo strip -->
  <section class="py-8 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
        <button class="aspect-[4/3] overflow-hidden rounded-lg cursor-pointer photo-open" data-src="/images/team/team-2023.jpg" data-alt="Ball'rz 2023 team">
          <img src="/images/team/team-2023.jpg" alt="Ball'rz 2023 team" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
        </button>
        <button class="aspect-[4/3] overflow-hidden rounded-lg cursor-pointer photo-open" data-src="/images/team/team-2022.jpg" data-alt="Ball'rz Fall 2022">
          <img src="/images/team/team-2022.jpg" alt="Ball'rz Fall 2022" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
        </button>
        <button class="aspect-[4/3] overflow-hidden rounded-lg cursor-pointer photo-open" data-src="/images/team/gsws-2023.jpg" data-alt="GSWS Minneapolis 2023">
          <img src="/images/team/gsws-2023.jpg" alt="GSWS Minneapolis 2023" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
        </button>
        <button class="aspect-[4/3] overflow-hidden rounded-lg cursor-pointer photo-open" data-src="/images/team/team-2019.jpg" data-alt="Ball'rz 2019 team">
          <img src="/images/team/team-2019.jpg" alt="Ball'rz 2019 team" class="w-full h-full object-cover hover:scale-105 transition-transform duration-300" loading="lazy" />
        </button>
      </div>
    </div>
  </section>

  <!-- Photo modal -->
  <div id="photo-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 p-4 cursor-pointer" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button class="absolute top-4 right-4 text-white/70 hover:text-white text-3xl leading-none" aria-label="Close">&times;</button>
    <img id="photo-modal-img" src="" alt="" class="max-w-full max-h-[90vh] rounded-lg shadow-2xl" />
  </div>

  <script is:inline>
  (function() {
    var modal = document.getElementById('photo-modal');
    var modalImg = document.getElementById('photo-modal-img');
    if (!modal || !modalImg) return;

    document.querySelectorAll('.photo-open').forEach(function(btn) {
      btn.addEventListener('click', function() {
        modalImg.src = btn.dataset.src;
        modalImg.alt = btn.dataset.alt;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
    });

    modal.addEventListener('click', function(e) {
      if (e.target === modal || e.target.tagName === 'BUTTON') {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }
    });
  })();
  </script>

  <!-- Mission — pull-quote style -->
  <section class="py-12 bg-white">
    <div class="max-w-2xl mx-auto px-6">
      <div class="border-l-4 border-[var(--ballrz-purple)] pl-5">
        <h2 class="text-xl font-bold text-[var(--ballrz-dark)] mb-2" style="font-family: var(--font-heading); letter-spacing: 0.03em;">Our Mission</h2>
        <p class="text-[var(--ballrz-gray-600)] leading-relaxed text-[0.95rem]">
          We believe softball is for everyone. Our team welcomes players of all ages, races, genders, and backgrounds. Whether you're a seasoned player or picking up a bat for the first time, you belong here.
        </p>
      </div>
    </div>
  </section>

  <!-- Achievements — scoreboard style -->
  <section class="py-12 bg-[var(--ballrz-dark)]">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-xl font-bold text-white/90 mb-6 text-center uppercase tracking-widest" style="font-family: var(--font-heading);">On the Field</h2>
      <div class="grid grid-cols-3 gap-3 md:gap-4 text-center">
        <div class="bg-[#162033] rounded-lg p-5 md:p-6">
          <p class="text-3xl md:text-4xl font-bold text-white" style="font-family: var(--font-heading); letter-spacing: 0.02em;">5</p>
          <p class="text-xs text-white/50 mt-1.5 uppercase tracking-wider" style="font-family: var(--font-heading);">World Series</p>
        </div>
        <div class="bg-[#162033] rounded-lg p-5 md:p-6">
          <p class="text-3xl md:text-4xl font-bold text-white" style="font-family: var(--font-heading); letter-spacing: 0.02em;">4th</p>
          <p class="text-xs text-white/50 mt-1.5 uppercase tracking-wider" style="font-family: var(--font-heading);">Best Finish '19</p>
        </div>
        <div class="bg-[#162033] rounded-lg p-5 md:p-6">
          <p class="text-3xl md:text-4xl font-bold text-white" style="font-family: var(--font-heading); letter-spacing: 0.02em;">2013</p>
          <p class="text-xs text-white/50 mt-1.5 uppercase tracking-wider" style="font-family: var(--font-heading);">Founded</p>
        </div>
      </div>
      <p class="text-center mt-5">
        <a href="/achievements/" class="text-sm font-semibold text-[#9b5de5] hover:text-white transition-colors uppercase tracking-wider" style="font-family: var(--font-heading);">
          View All Achievements &rarr;
        </a>
      </p>
    </div>
  </section>

  <!-- Sponsors -->
  <section class="py-12 bg-[var(--ballrz-gray-50)]">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="text-xl font-bold text-[var(--ballrz-dark)] mb-3" style="font-family: var(--font-heading); letter-spacing: 0.03em;">Become a Sponsor</h2>
      <p class="text-[var(--ballrz-gray-600)] text-[0.95rem] mb-5">Support LGBTQ+ athletics in Austin. Sponsorship packages start at $250.</p>
      <a href="/sponsors/" class="inline-block px-5 py-2.5 bg-[var(--ballrz-purple)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--ballrz-purple-dark)] transition-colors" style="font-family: var(--font-heading); letter-spacing: 0.04em;">
        View Packages
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
