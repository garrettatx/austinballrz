---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { organizationSchema } from '../lib/schema';
---

<Layout
  title={`${site.name} — ${site.tagline}`}
  jsonLd={organizationSchema()}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-6 py-14 md:py-20">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.1fr] gap-10 md:gap-14 items-center">

        <!-- Left: identity + message -->
        <div>
          <img
            src="/images/logo.svg"
            alt="Austin Ball'rz logo"
            width="240"
            height="170"
            class="w-44 md:w-56 mb-6"
          />
          <h1 class="text-3xl md:text-4xl font-extrabold text-[var(--ballrz-dark)] leading-tight mb-4">
            Play Bold,
            <span class="text-[var(--ballrz-purple)]">Play Proud.</span>
          </h1>
          <p class="text-[var(--ballrz-gray-600)] leading-relaxed mb-6 max-w-sm">
            LGBTQ+ inclusive softball in Austin, Texas. Since 2013, we've built a team where everyone belongs — on the field and off.
          </p>
          <div class="flex items-center gap-3 flex-wrap">
            <a href="/history/" class="px-5 py-2.5 bg-[var(--ballrz-purple)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--ballrz-purple-dark)] transition-colors">
              Our Story
            </a>
            <a href="/contact/" class="px-5 py-2.5 border-2 border-[var(--ballrz-gray-200)] text-[var(--ballrz-gray-600)] text-sm font-semibold rounded-lg hover:border-[var(--ballrz-purple)] hover:text-[var(--ballrz-purple)] transition-colors">
              Get in Touch
            </a>
          </div>
        </div>

        <!-- Right: team photo -->
        <div class="rounded-2xl overflow-hidden aspect-[4/3]">
          <img
            src="/images/team/hero-hands.jpg"
            alt="Austin Ball'rz team huddle"
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </div>

    <!-- Baseball stitch divider -->
    <div class="max-w-5xl mx-auto px-6">
      <svg viewBox="0 0 800 24" class="w-full h-6" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,12 Q200,0 400,12 T800,12" fill="none" stroke="#42168A" stroke-width="1.5" opacity="0.12" />
        <path d="M0,12 Q200,24 400,12 T800,12" fill="none" stroke="#42168A" stroke-width="1.5" opacity="0.12" />
      </svg>
    </div>
  </section>

  <!-- About -->
  <section class="py-14 bg-[var(--ballrz-gray-50)]">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-[var(--ballrz-dark)] mb-4">About Us</h2>
      <p class="text-[var(--ballrz-gray-600)] leading-relaxed">
        Since our founding in 2013, the Austin Ball'rz have become a vibrant part of Softball Austin. Originally named the Austin Aardvarks, we rebranded in 2014 and haven't looked back. We compete in league play and travel to regional and national tournaments — including multiple iPride World Series appearances.
      </p>
    </div>
  </section>

  <!-- Photo strip -->
  <section class="py-10 bg-white">
    <div class="max-w-5xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="aspect-[4/3] overflow-hidden rounded-lg">
          <img src="/images/team/team-2023.jpg" alt="Ball'rz 2023 team" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-lg">
          <img src="/images/team/team-2022.jpg" alt="Ball'rz Fall 2022 team" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-lg">
          <img src="/images/team/gsws-2023.jpg" alt="Ball'rz at GSWS Minneapolis 2023" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-lg">
          <img src="/images/team/team-2019.jpg" alt="Ball'rz 2019 team" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
      <p class="text-center text-xs text-[var(--ballrz-gray-400)] mt-3">Since 2013</p>
    </div>
  </section>

  <!-- Mission -->
  <section class="py-14 bg-[var(--ballrz-gray-50)]">
    <div class="max-w-2xl mx-auto px-6">
      <div class="border-l-4 border-[var(--ballrz-purple)] pl-6">
        <h2 class="text-2xl font-bold text-[var(--ballrz-dark)] mb-3">Our Mission</h2>
        <p class="text-[var(--ballrz-gray-600)] leading-relaxed">
          We believe softball is for everyone. Our team welcomes players of all ages, races, genders, and backgrounds. Whether you're a seasoned player or picking up a bat for the first time, you belong here.
        </p>
      </div>
    </div>
  </section>

  <!-- Achievements -->
  <section class="py-14 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-2xl font-bold text-[var(--ballrz-dark)] mb-8 text-center">On the Field</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        <div class="bg-white rounded-xl p-6 border border-[var(--ballrz-gray-200)] border-t-4 border-t-[var(--ballrz-purple)]">
          <p class="text-3xl font-extrabold text-[var(--ballrz-purple)] mb-1">5</p>
          <p class="text-sm text-[var(--ballrz-gray-600)]">World Series Appearances</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-[var(--ballrz-gray-200)] border-t-4 border-t-[var(--ballrz-purple)]">
          <p class="text-3xl font-extrabold text-[var(--ballrz-purple)] mb-1">4th</p>
          <p class="text-sm text-[var(--ballrz-gray-600)]">Best Finish — 2019 Kansas City</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-[var(--ballrz-gray-200)] border-t-4 border-t-[var(--ballrz-purple)]">
          <p class="text-3xl font-extrabold text-[var(--ballrz-purple)] mb-1">2013</p>
          <p class="text-sm text-[var(--ballrz-gray-600)]">Founded in Austin, TX</p>
        </div>
      </div>
      <div class="text-center mt-6">
        <a href="/achievements/" class="text-sm font-semibold text-[var(--ballrz-purple)] hover:underline">
          View All Achievements &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Sponsors CTA -->
  <section class="py-14 bg-[var(--ballrz-gray-50)]">
    <!-- Baseball stitch divider -->
    <div class="max-w-5xl mx-auto px-6 mb-10">
      <svg viewBox="0 0 800 24" class="w-full h-6" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,12 Q200,0 400,12 T800,12" fill="none" stroke="#42168A" stroke-width="1.5" opacity="0.12" />
        <path d="M0,12 Q200,24 400,12 T800,12" fill="none" stroke="#42168A" stroke-width="1.5" opacity="0.12" />
      </svg>
    </div>
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-[var(--ballrz-dark)] mb-3">Become a Sponsor</h2>
      <p class="text-[var(--ballrz-gray-600)] mb-6">Support LGBTQ+ athletics in Austin. Sponsorship packages start at $250.</p>
      <a href="/sponsors/" class="px-5 py-2.5 bg-[var(--ballrz-purple)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--ballrz-purple-dark)] transition-colors">
        View Packages
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
