---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { organizationSchema } from '../lib/schema';
---

<Layout
  title={`${site.name} — ${site.tagline}`}
  jsonLd={organizationSchema()}
>
  <Header slot="header" />

  <!-- Hero — split layout inspired by brand mockups -->
  <section class="relative bg-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 py-16 md:py-24">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

        <!-- Left: logo + headline -->
        <div>
          <img
            src="/images/logo.svg"
            alt="Austin Ball'rz logo"
            width="280"
            height="200"
            class="mb-8 w-56 md:w-72"
          />
          <h1 class="text-4xl md:text-5xl font-extrabold uppercase tracking-tight text-[var(--ballrz-dark)] leading-[1.1] mb-6">
            Play Bold,<br/>
            <span class="text-[var(--ballrz-purple)]">Play Proud.</span>
          </h1>
          <p class="text-lg text-[var(--ballrz-gray-600)] leading-relaxed mb-8 max-w-md">
            LGBTQ+ inclusive softball in Austin, Texas. Since 2013, we've built a team where everyone belongs — on the field and off.
          </p>
          <div class="flex items-center gap-4 flex-wrap">
            <a href="/history/" class="px-6 py-3 bg-[var(--ballrz-purple)] text-white font-semibold rounded-lg hover:bg-[var(--ballrz-purple-dark)] transition-colors">
              Our Story
            </a>
            <a href="/contact/" class="px-6 py-3 border-2 border-[var(--ballrz-purple)] text-[var(--ballrz-purple)] font-semibold rounded-lg hover:bg-[var(--ballrz-purple)] hover:text-white transition-colors">
              Get in Touch
            </a>
          </div>
        </div>

        <!-- Right: action photo placeholder with curved frame + purple accent -->
        <div class="relative">
          <!-- Purple accent shape (behind photo) -->
          <div class="absolute -top-6 -right-6 w-full h-full rounded-[1rem_4rem_1rem_4rem] bg-[var(--ballrz-purple)]" aria-hidden="true"></div>
          <!-- Photo container -->
          <div class="relative ballrz-photo-frame aspect-[4/3] bg-[var(--ballrz-gray-100)] flex items-center justify-center">
            <!-- Replace with actual team action photo -->
            <div class="text-center text-[var(--ballrz-gray-400)] p-8">
              <svg class="w-16 h-16 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <p class="text-sm">Team photo goes here</p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Rainbow accent bar -->
    <div class="ballrz-rainbow h-1.5" aria-hidden="true"></div>
  </section>

  <!-- About -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-[var(--ballrz-dark)] mb-4 uppercase tracking-wide">About Us</h2>
      <p class="text-[var(--ballrz-gray-600)] leading-relaxed text-lg">
        Since our founding in 2013, the Austin Ball'rz have become a vibrant part of Softball Austin. Originally named the Austin Aardvarks, we rebranded in 2014 and haven't looked back. We compete in league play and travel to regional and national tournaments — including multiple iPride World Series appearances.
      </p>
    </div>
  </section>

  <!-- Mission -->
  <section class="relative py-16 overflow-hidden">
    <div class="absolute inset-0 ballrz-gradient opacity-95"></div>
    <div class="relative max-w-3xl mx-auto px-6 text-center text-white">
      <h2 class="text-2xl font-bold mb-4 uppercase tracking-wide">Our Mission</h2>
      <p class="text-white/85 text-lg leading-relaxed">
        We believe softball is for everyone. Our team welcomes players of all ages, races, genders, and backgrounds. Whether you're a seasoned player or picking up a bat for the first time, you belong here.
      </p>
    </div>
  </section>

  <!-- Achievements highlight -->
  <section class="py-16 bg-[var(--ballrz-gray-50)]">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-2xl font-bold text-[var(--ballrz-dark)] mb-8 uppercase tracking-wide text-center">On the Field</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
        <div class="bg-white rounded-xl p-6 border border-[var(--ballrz-gray-200)]">
          <p class="text-3xl font-extrabold text-[var(--ballrz-purple)] mb-1">5</p>
          <p class="text-sm text-[var(--ballrz-gray-600)]">World Series appearances</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-[var(--ballrz-gray-200)]">
          <p class="text-3xl font-extrabold text-[var(--ballrz-purple)] mb-1">4th</p>
          <p class="text-sm text-[var(--ballrz-gray-600)]">Best finish — 2019 Kansas City</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-[var(--ballrz-gray-200)]">
          <p class="text-3xl font-extrabold text-[var(--ballrz-purple)] mb-1">2013</p>
          <p class="text-sm text-[var(--ballrz-gray-600)]">Founded in Austin, TX</p>
        </div>
      </div>
      <div class="text-center mt-8">
        <a href="/achievements/" class="text-sm font-semibold text-[var(--ballrz-purple)] hover:underline">
          View all achievements &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Sponsors CTA -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-[var(--ballrz-dark)] mb-4 uppercase tracking-wide">Become a Sponsor</h2>
      <p class="text-[var(--ballrz-gray-600)] text-lg mb-6">Support LGBTQ+ athletics in Austin. Sponsorship packages start at $250.</p>
      <a href="/sponsors/" class="px-6 py-3 bg-[var(--ballrz-purple)] text-white font-semibold rounded-lg hover:bg-[var(--ballrz-purple-dark)] transition-colors">
        View Packages
      </a>
    </div>
  </section>

  <!-- Bottom accent bar -->
  <div class="ballrz-rainbow h-1.5" aria-hidden="true"></div>

  <Footer slot="footer" />
</Layout>
