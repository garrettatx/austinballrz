---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { organizationSchema } from '../lib/schema';
---

<Layout
  title={`${site.name} — ${site.tagline}`}
  jsonLd={organizationSchema()}
>
  <Header slot="header" />

  <!-- Hero — split layout with team photo -->
  <section class="relative overflow-hidden ballrz-stitch-bg" style="background: linear-gradient(160deg, var(--ballrz-purple-dark) 0%, var(--ballrz-purple) 60%, var(--ballrz-purple-light) 100%);">
    <!-- Decorative diamond shapes -->
    <div class="ballrz-diamond text-white" style="top: -60px; left: 5%;" aria-hidden="true"></div>
    <div class="ballrz-diamond text-white" style="bottom: -80px; right: 10%; width: 160px; height: 160px;" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-16 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">

        <!-- Left: logo + headline -->
        <div>
          <img
            src="/images/logo.svg"
            alt="Austin Ball'rz logo"
            width="280"
            height="200"
            class="mb-6 w-48 md:w-64"
          />
          <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white leading-[1.1] mb-4">
            Play Bold,<br/>
            <span class="text-[var(--ballrz-purple-light)]">Play Proud.</span>
          </h1>
          <p class="text-base text-white/70 leading-relaxed mb-6 max-w-md">
            LGBTQ+ inclusive softball in Austin, Texas. Since 2013, we've built a team where everyone belongs — on the field and off.
          </p>
          <div class="flex items-center gap-3 flex-wrap">
            <a href="/history/" class="px-5 py-2.5 bg-[var(--ballrz-purple)] text-white font-semibold rounded-lg hover:bg-[var(--ballrz-purple-dark)] transition-colors text-sm">
              Our Story
            </a>
            <a href="/contact/" class="px-5 py-2.5 border-2 border-white/30 text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-sm">
              Get in Touch
            </a>
          </div>
        </div>

        <!-- Right: team photo with curved frame + purple accent -->
        <div class="relative">
          <div class="absolute -top-4 -right-4 w-full h-full rounded-[1rem_3rem_1rem_3rem] bg-[var(--ballrz-purple)]" aria-hidden="true"></div>
          <div class="relative ballrz-photo-frame aspect-[4/3] overflow-hidden">
            <img
              src="/images/team/hero-hands.jpg"
              alt="Austin Ball'rz team huddle"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>
    <div class="ballrz-rainbow h-1.5" aria-hidden="true"></div>
  </section>

  <!-- About -->
  <section class="py-14 bg-white relative overflow-hidden">
    <img src="/images/seam-right.svg" class="ballrz-seam-right" alt="" aria-hidden="true" />
    <div class="max-w-2xl mx-auto px-6 text-center relative z-10">
      <h2 class="text-2xl font-bold text-[var(--ballrz-dark)] mb-4">About Us</h2>
      <p class="text-[var(--ballrz-gray-600)] leading-relaxed text-base">
        Since our founding in 2013, the Austin Ball'rz have become a vibrant part of Softball Austin. Originally named the Austin Aardvarks, we rebranded in 2014 and haven't looked back. We compete in league play and travel to regional and national tournaments — including multiple iPride World Series appearances.
      </p>
    </div>
  </section>

  <!-- Team photos strip -->
  <section class="py-10 bg-[var(--ballrz-gray-50)]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="aspect-[4/3] overflow-hidden rounded-lg">
          <img src="/images/team/team-2023.jpg" alt="Ball'rz 2023 team photo" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-lg">
          <img src="/images/team/team-2022.jpg" alt="Ball'rz Fall 2022 team photo" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-lg">
          <img src="/images/team/gsws-2023.jpg" alt="Ball'rz at GSWS Minneapolis 2023" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-lg">
          <img src="/images/team/team-2019.jpg" alt="Ball'rz 2019 team photo" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Mission -->
  <section class="relative py-12 overflow-hidden">
    <div class="absolute inset-0 ballrz-gradient"></div>
    <div class="relative max-w-3xl mx-auto px-6 text-center text-white">
      <h2 class="text-2xl font-bold mb-3">Our Mission</h2>
      <p class="text-white/85 leading-relaxed">
        We believe softball is for everyone. Our team welcomes players of all ages, races, genders, and backgrounds. Whether you're a seasoned player or picking up a bat for the first time, you belong here.
      </p>
    </div>
  </section>

  <!-- Achievements -->
  <section class="py-12 bg-white relative overflow-hidden">
    <img src="/images/seam-left.svg" class="ballrz-seam-left" alt="" aria-hidden="true" />
    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <h2 class="text-2xl font-bold text-[var(--ballrz-dark)] mb-6 text-center">On the Field</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        <div class="bg-[var(--ballrz-gray-50)] rounded-xl p-5">
          <p class="text-3xl font-extrabold text-[var(--ballrz-purple)] mb-1">5</p>
          <p class="text-sm text-[var(--ballrz-gray-600)]">World Series Appearances</p>
        </div>
        <div class="bg-[var(--ballrz-gray-50)] rounded-xl p-5">
          <p class="text-3xl font-extrabold text-[var(--ballrz-purple)] mb-1">4th</p>
          <p class="text-sm text-[var(--ballrz-gray-600)]">Best Finish — 2019 Kansas City</p>
        </div>
        <div class="bg-[var(--ballrz-gray-50)] rounded-xl p-5">
          <p class="text-3xl font-extrabold text-[var(--ballrz-purple)] mb-1">2013</p>
          <p class="text-sm text-[var(--ballrz-gray-600)]">Founded in Austin, TX</p>
        </div>
      </div>
      <div class="text-center mt-6">
        <a href="/achievements/" class="text-sm font-semibold text-[var(--ballrz-purple)] hover:underline">
          View All Achievements &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Sponsors CTA -->
  <section class="py-12 bg-[var(--ballrz-gray-50)]">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-2xl font-bold text-[var(--ballrz-dark)] mb-3">Become a Sponsor</h2>
      <p class="text-[var(--ballrz-gray-600)] mb-5">Support LGBTQ+ athletics in Austin. Sponsorship packages start at $250.</p>
      <a href="/sponsors/" class="px-5 py-2.5 bg-[var(--ballrz-purple)] text-white font-semibold rounded-lg hover:bg-[var(--ballrz-purple-dark)] transition-colors text-sm">
        View Packages
      </a>
    </div>
  </section>

  <div class="ballrz-rainbow h-1.5" aria-hidden="true"></div>

  <Footer slot="footer" />
</Layout>
