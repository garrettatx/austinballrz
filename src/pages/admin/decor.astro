---
import { site } from '../../data/site';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Decorative Sets | {site.name}</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    @font-face { font-family: 'Barlow Condensed'; font-style: normal; font-weight: 700; font-display: swap; src: url('/fonts/barlow-condensed-700.woff2') format('woff2'); }
    @font-face { font-family: 'Barlow Condensed'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/barlow-condensed-600.woff2') format('woff2'); }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #374151; line-height: 1.6; background: #f0f0f3; }
    .heading { font-family: 'Barlow Condensed', sans-serif; color: #0D1B2A; line-height: 1.15; letter-spacing: 0.01em; }

    /* Page layout */
    .page-header { background: #263a5a; color: white; padding: 2rem 1.5rem; text-align: center; }
    .page-header h1 { font-family: 'Barlow Condensed', sans-serif; font-size: 1.5rem; font-weight: 700; }
    .page-header p { font-size: 0.875rem; color: #a8b4c4; margin-top: 0.25rem; }

    .set { background: white; margin: 2rem auto; max-width: 900px; border-radius: 1rem; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
    .set-label { background: #0D1B2A; color: white; padding: 1rem 1.5rem; font-family: 'Barlow Condensed', sans-serif; font-size: 1.125rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    .set-label span { font-weight: 400; font-size: 0.8rem; text-transform: none; color: #a8b4c4; margin-left: 0.75rem; }
    .set-desc { padding: 1rem 1.5rem; background: #f7f7f8; font-size: 0.85rem; color: #6b7280; border-bottom: 1px solid #e5e7eb; }

    .demo-section { padding: 1.5rem; border-bottom: 1px solid #f0f0f3; }
    .demo-section:last-child { border-bottom: none; }
    .demo-label { font-family: 'Barlow Condensed', sans-serif; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #6b7280; margin-bottom: 0.75rem; }

    /* Shared mock elements */
    .mock-hero { background: white; padding: 2rem 1.5rem; position: relative; overflow: hidden; }
    .mock-hero h2 { font-family: 'Barlow Condensed', sans-serif; font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 700; color: #0D1B2A; line-height: 1.1; }
    .mock-hero h2 em { font-style: normal; color: #42168A; }
    .mock-hero p { margin-top: 0.5rem; max-width: 48ch; font-size: 0.9rem; color: #374151; }

    .mock-content { padding: 1.5rem; }
    .mock-content h3 { font-family: 'Barlow Condensed', sans-serif; font-size: 1.125rem; font-weight: 700; color: #0D1B2A; margin-bottom: 0.5rem; }
    .mock-content p { font-size: 0.875rem; color: #374151; max-width: 55ch; }

    .mock-footer { background: #263a5a; padding: 1.5rem; color: rgba(255,255,255,0.7); font-size: 0.8rem; position: relative; overflow: hidden; }
    .mock-footer strong { color: white; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 1rem; }

    .mock-card { border: 1px solid #e2e2e6; border-radius: 0.5rem; padding: 1rem 1.25rem; position: relative; overflow: hidden; }
    .mock-card h4 { font-family: 'Barlow Condensed', sans-serif; font-size: 1rem; font-weight: 600; color: #0D1B2A; }
    .mock-card p { font-size: 0.8rem; color: #6b7280; margin-top: 0.25rem; }
    .card-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  </style>
</head>
<body>

<div class="page-header">
  <h1>Decorative Sets</h1>
  <p>5 directions — scroll to compare. Each shows hero, divider, footer, and accent.</p>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- SET A: SEAM LINE -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="set">
  <div class="set-label">Set A: Seam Line <span>Minimal curved softball seam as a quiet signature</span></div>
  <div class="set-desc">A single curved seam line used as section dividers and a faint hero accent. The most restrained option — just one decorative element repeated in different contexts.</div>

  <div class="demo-section">
    <div class="demo-label">Hero</div>
    <div class="mock-hero" style="border-bottom: none;">
      <svg style="position: absolute; bottom: 0; left: 0; width: 100%; height: 40px; opacity: 0.07;" viewBox="0 0 1200 40" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0,35 Q300,0 600,35 T1200,35" fill="none" stroke="#42168A" stroke-width="3"/>
      </svg>
      <h2>PLAY BOLD, <em>PLAY PROUD.</em></h2>
      <p>We're an LGBTQ+ softball team in Austin, Texas.</p>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Section Divider</div>
    <div style="padding: 1rem 0;">
      <svg style="display: block; width: 100%; height: 20px; opacity: 0.1;" viewBox="0 0 1200 20" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0,15 Q300,0 600,15 T1200,15" fill="none" stroke="#42168A" stroke-width="2"/>
      </svg>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Footer</div>
    <div class="mock-footer">
      <svg style="position: absolute; top: 0; left: 0; width: 100%; height: 16px; opacity: 0.12;" viewBox="0 0 1200 16" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0,12 Q300,0 600,12 T1200,12" fill="none" stroke="#c4a5f0" stroke-width="2"/>
      </svg>
      <div style="padding-top: 0.75rem;">
        <strong>Austin Ball'rz</strong><br/>
        LGBTQ+ Inclusive Softball in Austin, TX
      </div>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Card Accent (optional)</div>
    <div class="card-row">
      <div class="mock-card">
        <svg style="position: absolute; bottom: 0; left: 0; width: 100%; height: 8px; opacity: 0.06;" viewBox="0 0 400 8" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M0,6 Q100,0 200,6 T400,6" fill="none" stroke="#42168A" stroke-width="1.5"/>
        </svg>
        <h4>Champion</h4>
        <p>$2,500 — Logo on jerseys</p>
      </div>
      <div class="mock-card">
        <svg style="position: absolute; bottom: 0; left: 0; width: 100%; height: 8px; opacity: 0.06;" viewBox="0 0 400 8" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M0,6 Q100,0 200,6 T400,6" fill="none" stroke="#42168A" stroke-width="1.5"/>
        </svg>
        <h4>MVP</h4>
        <p>$1,000 — Banner + website</p>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- SET B: DIAMOND MARKER -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="set">
  <div class="set-label">Set B: Diamond Marker <span>Centered rotated-square motif — geometric, scorecard feel</span></div>
  <div class="set-desc">A small diamond (rotated square) used as a centered ornamental break between sections. Clean and geometric — evokes home plate and baseball scorecard aesthetics.</div>

  <div class="demo-section">
    <div class="demo-label">Hero</div>
    <div class="mock-hero">
      <h2>PLAY BOLD, <em>PLAY PROUD.</em><span style="display: inline-block; width: 10px; height: 10px; background: #42168A; transform: rotate(45deg); margin-left: 0.5rem; vertical-align: middle; opacity: 0.3;"></span></h2>
      <p>We're an LGBTQ+ softball team in Austin, Texas.</p>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Section Divider</div>
    <div style="display: flex; align-items: center; gap: 1rem; padding: 1rem 1.5rem;">
      <div style="flex: 1; height: 1px; background: #e2e2e6;"></div>
      <div style="width: 8px; height: 8px; background: #42168A; transform: rotate(45deg); opacity: 0.2;"></div>
      <div style="flex: 1; height: 1px; background: #e2e2e6;"></div>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Footer</div>
    <div class="mock-footer">
      <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem; opacity: 0.15;">
        <div style="width: 5px; height: 5px; background: #c4a5f0; transform: rotate(45deg);"></div>
        <div style="width: 5px; height: 5px; background: #c4a5f0; transform: rotate(45deg);"></div>
        <div style="width: 5px; height: 5px; background: #c4a5f0; transform: rotate(45deg);"></div>
      </div>
      <strong>Austin Ball'rz</strong><br/>
      LGBTQ+ Inclusive Softball in Austin, TX
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Card Accent (optional)</div>
    <div class="card-row">
      <div class="mock-card">
        <div style="position: absolute; top: -4px; right: -4px; width: 10px; height: 10px; background: #42168A; transform: rotate(45deg); opacity: 0.08;"></div>
        <h4>Champion</h4>
        <p>$2,500 — Logo on jerseys</p>
      </div>
      <div class="mock-card">
        <div style="position: absolute; top: -4px; right: -4px; width: 10px; height: 10px; background: #42168A; transform: rotate(45deg); opacity: 0.08;"></div>
        <h4>MVP</h4>
        <p>$1,000 — Banner + website</p>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- SET C: FIELD LINES -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="set">
  <div class="set-label">Set C: Field Lines <span>Faint outfield arcs and foul-line rules — spatial, atmospheric</span></div>
  <div class="set-desc">Very faint curved arcs in the hero (like a bird's-eye view of the outfield). Section dividers use a thin double-line rule (like foul lines). Atmospheric — you feel the field without seeing it literally.</div>

  <div class="demo-section">
    <div class="demo-label">Hero</div>
    <div class="mock-hero" style="min-height: 120px;">
      <svg style="position: absolute; bottom: -20px; right: -40px; width: 280px; height: 280px; opacity: 0.04;" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
        <circle cx="200" cy="200" r="80" fill="none" stroke="#42168A" stroke-width="2"/>
        <circle cx="200" cy="200" r="130" fill="none" stroke="#42168A" stroke-width="1.5"/>
        <circle cx="200" cy="200" r="180" fill="none" stroke="#42168A" stroke-width="1"/>
      </svg>
      <h2>PLAY BOLD, <em>PLAY PROUD.</em></h2>
      <p>We're an LGBTQ+ softball team in Austin, Texas.</p>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Section Divider</div>
    <div style="padding: 1rem 1.5rem;">
      <div style="border-top: 1px solid #e2e2e6; margin-bottom: 3px;"></div>
      <div style="border-top: 1px solid #e2e2e6;"></div>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Footer</div>
    <div class="mock-footer">
      <svg style="position: absolute; top: -30px; left: 50%; transform: translateX(-50%); width: 400px; height: 60px; opacity: 0.08;" viewBox="0 0 400 60" aria-hidden="true" focusable="false">
        <path d="M0,60 Q200,-20 400,60" fill="none" stroke="#c4a5f0" stroke-width="1.5"/>
      </svg>
      <strong>Austin Ball'rz</strong><br/>
      LGBTQ+ Inclusive Softball in Austin, TX
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Heading Accent (optional)</div>
    <div class="mock-content">
      <h3 style="display: flex; align-items: center; gap: 0.5rem;">About Us <svg style="width: 24px; height: 2px; opacity: 0.15;" viewBox="0 0 24 4" aria-hidden="true" focusable="false"><line x1="0" y1="1" x2="24" y2="1" stroke="#42168A" stroke-width="1"/><line x1="0" y1="3" x2="24" y2="3" stroke="#42168A" stroke-width="1"/></svg></h3>
      <p>We play in Softball Austin, part of the iPride Softball League.</p>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- SET D: STITCHED RULE -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="set">
  <div class="set-label">Set D: Stitched Rule <span>Abstracted softball stitching as a geometric divider — tactile, craft-forward</span></div>
  <div class="set-desc">Section dividers are a thin line with small alternating tick marks mimicking softball stitching. The single most recognizable softball visual element, translated into a clean decorative rule. Recommended.</div>

  <div class="demo-section">
    <div class="demo-label">Hero</div>
    <div class="mock-hero">
      <h2>PLAY BOLD, <em>PLAY PROUD.</em></h2>
      <svg style="display: block; width: 180px; height: 16px; margin-top: 0.5rem; opacity: 0.45;" viewBox="0 0 180 16" aria-hidden="true" focusable="false">
        <path d="M0,8 Q30,4 60,8 T120,8 T180,8" fill="none" stroke="#D92638" stroke-width="3"/>
        <line x1="28" y1="1" x2="32" y2="15" stroke="#D92638" stroke-width="2"/>
        <line x1="88" y1="1" x2="92" y2="15" stroke="#D92638" stroke-width="2"/>
        <line x1="148" y1="1" x2="152" y2="15" stroke="#D92638" stroke-width="2"/>
      </svg>
      <p style="margin-top: 0.625rem;">We're an LGBTQ+ softball team in Austin, Texas.</p>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Section Divider</div>
    <div style="padding: 1rem 1.5rem; display: flex; justify-content: center;">
      <svg style="display: block; width: 180px; height: 16px; opacity: 0.5;" viewBox="0 0 180 16" aria-hidden="true" focusable="false">
        <path d="M0,8 Q30,4 60,8 T120,8 T180,8" fill="none" stroke="#D92638" stroke-width="3"/>
        <line x1="28" y1="1" x2="32" y2="15" stroke="#D92638" stroke-width="2"/>
        <line x1="88" y1="1" x2="92" y2="15" stroke="#D92638" stroke-width="2"/>
        <line x1="148" y1="1" x2="152" y2="15" stroke="#D92638" stroke-width="2"/>
      </svg>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Footer</div>
    <div class="mock-footer">
      <em style="font-style: normal; font-size: 0.7rem; color: rgba(255,255,255,0.35);">No footer treatment — keep clean. Rainbow bar + existing footer are enough.</em><br/><br/>
      <strong>Austin Ball'rz</strong><br/>
      LGBTQ+ Inclusive Softball in Austin, TX
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Card Accent (optional)</div>
    <em style="font-size: 0.8rem; color: #6b7280; padding: 0 1.5rem;">Same stitched rule at smaller scale on top edge of cards:</em>
    <div class="card-row" style="margin-top: 0.75rem;">
      <div class="mock-card">
        <svg style="position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 80px; height: 10px; opacity: 0.3;" viewBox="0 0 80 10" aria-hidden="true" focusable="false">
          <path d="M0,5 Q10,3 20,5 T40,5 T60,5 T80,5" fill="none" stroke="#D92638" stroke-width="1.5"/>
          <line x1="9" y1="1" x2="11.5" y2="9" stroke="#D92638" stroke-width="1.2"/>
          <line x1="29" y1="1" x2="31.5" y2="9" stroke="#D92638" stroke-width="1.2"/>
          <line x1="49" y1="1" x2="51.5" y2="9" stroke="#D92638" stroke-width="1.2"/>
          <line x1="69" y1="1" x2="71.5" y2="9" stroke="#D92638" stroke-width="1.2"/>
        </svg>
        <h4>Champion</h4>
        <p>$2,500 — Logo on jerseys</p>
      </div>
      <div class="mock-card">
        <svg style="position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 80px; height: 10px; opacity: 0.3;" viewBox="0 0 80 10" aria-hidden="true" focusable="false">
          <path d="M0,5 Q10,3 20,5 T40,5 T60,5 T80,5" fill="none" stroke="#D92638" stroke-width="1.5"/>
          <line x1="9" y1="1" x2="11.5" y2="9" stroke="#D92638" stroke-width="1.2"/>
          <line x1="29" y1="1" x2="31.5" y2="9" stroke="#D92638" stroke-width="1.2"/>
          <line x1="49" y1="1" x2="51.5" y2="9" stroke="#D92638" stroke-width="1.2"/>
          <line x1="69" y1="1" x2="71.5" y2="9" stroke="#D92638" stroke-width="1.2"/>
        </svg>
        <h4>MVP</h4>
        <p>$1,000 — Banner + website</p>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- SET E: CORNER ACCENT -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="set">
  <div class="set-label">Set E: Corner Accent <span>L-shaped corner brackets — structured, editorial, batting-box geometry</span></div>
  <div class="set-desc">Small corner brackets placed at edges of key elements — hero photo, scoreboard, sponsor cards. Evokes a batter's box or editorial framing. Section dividers stay minimal. Structured without decorating.</div>

  <div class="demo-section">
    <div class="demo-label">Hero (photo frame accent)</div>
    <div class="mock-hero">
      <h2>PLAY BOLD, <em>PLAY PROUD.</em></h2>
      <p>We're an LGBTQ+ softball team in Austin, Texas.</p>
      <div style="margin-top: 1rem; width: 200px; height: 130px; background: #ddd; border-radius: 0.5rem; position: relative;">
        <div style="position: absolute; top: -4px; left: -4px; width: 20px; height: 20px; border-top: 2px solid rgba(66,22,138,0.25); border-left: 2px solid rgba(66,22,138,0.25);"></div>
        <div style="position: absolute; top: -4px; right: -4px; width: 20px; height: 20px; border-top: 2px solid rgba(66,22,138,0.25); border-right: 2px solid rgba(66,22,138,0.25);"></div>
        <div style="position: absolute; bottom: -4px; left: -4px; width: 20px; height: 20px; border-bottom: 2px solid rgba(66,22,138,0.25); border-left: 2px solid rgba(66,22,138,0.25);"></div>
        <div style="position: absolute; bottom: -4px; right: -4px; width: 20px; height: 20px; border-bottom: 2px solid rgba(66,22,138,0.25); border-right: 2px solid rgba(66,22,138,0.25);"></div>
        <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #999; font-size: 0.75rem;">[team photo]</div>
      </div>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Section Divider</div>
    <div style="padding: 1rem 1.5rem;">
      <div style="height: 1px; background: #e2e2e6;"></div>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Footer</div>
    <div class="mock-footer">
      <div style="display: inline-block; position: relative; padding: 0.5rem 0.75rem;">
        <div style="position: absolute; top: 0; left: 0; width: 14px; height: 14px; border-top: 1.5px solid rgba(196,165,240,0.3); border-left: 1.5px solid rgba(196,165,240,0.3);"></div>
        <div style="position: absolute; bottom: 0; right: 0; width: 14px; height: 14px; border-bottom: 1.5px solid rgba(196,165,240,0.3); border-right: 1.5px solid rgba(196,165,240,0.3);"></div>
        <strong>Austin Ball'rz</strong>
      </div>
      <br/>
      <span style="font-size: 0.75rem;">LGBTQ+ Inclusive Softball in Austin, TX</span>
    </div>
  </div>

  <div class="demo-section">
    <div class="demo-label">Card Accent</div>
    <div class="card-row">
      <div class="mock-card" style="position: relative;">
        <div style="position: absolute; top: 6px; left: 6px; width: 12px; height: 12px; border-top: 1.5px solid rgba(66,22,138,0.15); border-left: 1.5px solid rgba(66,22,138,0.15);"></div>
        <div style="position: absolute; bottom: 6px; right: 6px; width: 12px; height: 12px; border-bottom: 1.5px solid rgba(66,22,138,0.15); border-right: 1.5px solid rgba(66,22,138,0.15);"></div>
        <h4>Champion</h4>
        <p>$2,500 — Logo on jerseys</p>
      </div>
      <div class="mock-card" style="position: relative;">
        <div style="position: absolute; top: 6px; left: 6px; width: 12px; height: 12px; border-top: 1.5px solid rgba(66,22,138,0.15); border-left: 1.5px solid rgba(66,22,138,0.15);"></div>
        <div style="position: absolute; bottom: 6px; right: 6px; width: 12px; height: 12px; border-bottom: 1.5px solid rgba(66,22,138,0.15); border-right: 1.5px solid rgba(66,22,138,0.15);"></div>
        <h4>MVP</h4>
        <p>$1,000 — Banner + website</p>
      </div>
    </div>
  </div>
</div>

<div style="text-align: center; padding: 2rem; color: #6b7280; font-size: 0.8rem;">
  <p>Recommendation: <strong>Set D (Stitched Rule)</strong> — most recognizably softball, works at every scale.</p>
  <p style="margin-top: 0.25rem;">Runner-up: <strong>Set B (Diamond Marker)</strong> — cleaner, more geometric.</p>
  <p style="margin-top: 0.25rem;">These sets can also be mixed (e.g. Set D dividers + Set E card accents).</p>
</div>

</body>
</html>
