---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import AdminNav from '../../../../components/admin/AdminNav.astro';
---

<AdminLayout title="Photo Management" maxWidth="640px">
  <AdminNav current="/admin/dashboard/photos/" />
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
    <h1 style="font-size: 1.25rem; font-weight: 700;">Photos</h1>
    <a href="/admin/photo/" style="font-size: 0.8125rem; font-weight: 600; color: #42168A; text-decoration: none;">+ Submit new</a>
  </div>

  <div id="photos-pending"></div>
  <div id="photos-recent"></div>
  <div id="photos-empty" style="display: none; text-align: center; padding: 2rem 0; color: #9ca3af; font-size: 0.875rem;">
    No photo submissions found.
  </div>
  <div id="photos-error" style="display: none; text-align: center; padding: 2rem 0; color: #991b1b; font-size: 0.875rem;"></div>

  <Fragment slot="head">
    <style is:global>
      .section-label {
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #6b7280;
        margin-bottom: 0.625rem;
      }
      .section-divider {
        margin-top: 1.75rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e2e2e6;
      }

      /* Pending photo cards: thumbnail + info side by side */
      .photo-card {
        display: flex;
        gap: 0.875rem;
        padding: 0.875rem;
        border: 1px solid #e2e2e6;
        border-radius: 8px;
        margin-bottom: 0.625rem;
        align-items: flex-start;
        background: #ffffff;
      }
      .photo-card img {
        width: 120px;
        height: 90px;
        object-fit: cover;
        border-radius: 6px;
        background: #f0f0f4;
        flex-shrink: 0;
      }
      .photo-info {
        flex: 1;
        min-width: 0;
      }
      .photo-desc {
        font-size: 0.875rem;
        font-weight: 600;
        color: #1a1a2e;
        margin-bottom: 0.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .photo-meta {
        font-size: 0.6875rem;
        color: #9ca3af;
        margin-bottom: 0.375rem;
      }
      .photo-actions {
        display: flex;
        gap: 0.375rem;
        margin-top: 0.5rem;
      }
      .photo-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6875rem;
        font-weight: 600;
        color: #42168A;
        text-decoration: none;
        padding: 0.375rem 0.75rem;
        border: 1px solid #e2e2e6;
        border-radius: 6px;
        background: #ffffff;
        min-height: 44px;
        min-width: 44px;
        -webkit-tap-highlight-color: transparent;
      }
      .photo-btn:hover {
        border-color: #42168A;
        background: #f8f9fa;
      }

      /* Status badges */
      .photo-status {
        display: inline-block;
        font-size: 0.6875rem;
        font-weight: 600;
        padding: 0.125rem 0.5rem;
        border-radius: 100px;
        vertical-align: middle;
      }
      .status-open {
        background: #fef3c7;
        color: #92400e;
      }
      .status-merged {
        background: #ecfdf5;
        color: #065f46;
      }
      .status-closed {
        background: #fef2f2;
        color: #991b1b;
      }

      /* Recent items: compact list style */
      .recent-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid #f0f0f4;
        gap: 0.75rem;
      }
      .recent-item:last-child {
        border-bottom: none;
      }
      .recent-item-left {
        min-width: 0;
        flex: 1;
      }
      .recent-item-desc {
        font-size: 0.8125rem;
        font-weight: 500;
        color: #1a1a2e;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .recent-item-meta {
        font-size: 0.6875rem;
        color: #9ca3af;
      }
      .recent-list {
        border: 1px solid #e2e2e6;
        border-radius: 8px;
        overflow: hidden;
        background: #ffffff;
      }
    </style>
  </Fragment>
</AdminLayout>

<script is:inline>
(function() {
  var pendingEl = document.getElementById('photos-pending');
  var recentEl = document.getElementById('photos-recent');
  var emptyEl = document.getElementById('photos-empty');
  var errorEl = document.getElementById('photos-error');

  function formatDate(iso) {
    return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function esc(str) {
    if (!str) return '';
    var el = document.createElement('span');
    el.textContent = str;
    return el.innerHTML;
  }

  function statusBadge(state) {
    if (state === 'merged') return '<span class="photo-status status-merged">Published</span>';
    if (state === 'closed') return '<span class="photo-status status-closed">Rejected</span>';
    return '<span class="photo-status status-open">Pending</span>';
  }

  function pendingCard(p) {
    var showThumb = p.state === 'open' && p.image_url;
    return '<div class="photo-card">' +
      (showThumb ? '<img src="' + esc(p.image_url) + '" alt="' + esc(p.description || 'Photo') + '" loading="lazy" width="120" height="90" />' : '') +
      '<div class="photo-info">' +
        '<div class="photo-desc">' + esc(p.description || p.file || 'Untitled') + '</div>' +
        '<div class="photo-meta">' + [p.year, p.team, formatDate(p.created_at)].filter(Boolean).join(' \u00b7 ') + ' ' + statusBadge(p.state) + '</div>' +
        '<div class="photo-actions">' +
          '<a class="photo-btn" href="' + esc(p.review_url) + '">Review</a>' +
          '<a class="photo-btn" href="' + esc(p.github_url) + '">GitHub</a>' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  function recentItem(p) {
    return '<div class="recent-item">' +
      '<div class="recent-item-left">' +
        '<div class="recent-item-desc">' + esc(p.description || p.file || 'Untitled') + '</div>' +
        '<div class="recent-item-meta">' + [p.year, p.team, formatDate(p.created_at)].filter(Boolean).join(' \u00b7 ') + '</div>' +
      '</div>' +
      statusBadge(p.state) +
    '</div>';
  }

  async function load() {
    try {
      var res = await fetch('/api/admin/photos/');
      if (!res.ok) throw new Error('Could not load photos.');
      var data = await res.json();

      if (data.pending.length === 0 && data.recent.length === 0) {
        emptyEl.style.display = '';
        return;
      }

      if (data.pending.length > 0) {
        pendingEl.innerHTML = '<p class="section-label">Pending review (' + data.pending.length + ')</p>' +
          data.pending.map(pendingCard).join('');
      }

      if (data.recent.length > 0) {
        recentEl.innerHTML =
          '<p class="section-label' + (data.pending.length > 0 ? ' section-divider' : '') + '">Recent</p>' +
          '<div class="recent-list">' + data.recent.map(recentItem).join('') + '</div>';
      }
    } catch (err) {
      errorEl.textContent = err.message;
      errorEl.style.display = '';
    }
  }

  load();
})();
</script>
