---
import AdminLayout from '../../../../components/admin/AdminLayout.astro';
import AdminNav from '../../../../components/admin/AdminNav.astro';
---

<AdminLayout title="Messages" maxWidth="640px">
  <AdminNav current="/admin/dashboard/messages/" />
  <h1 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.25rem;">Messages</h1>
  <p id="msg-count" style="font-size: 0.8125rem; color: #6b7280; margin-bottom: 1.25rem;">Loading...</p>

  <div id="msg-list"></div>
  <div id="msg-empty" style="display: none; text-align: center; padding: 2rem 0; color: #9ca3af; font-size: 0.875rem;">
    No messages yet. Submissions from the contact form will appear here.
  </div>
  <div id="msg-error" style="display: none; text-align: center; padding: 2rem 0; color: #991b1b; font-size: 0.875rem;"></div>

  <Fragment slot="head">
    <style is:global>
      .msg-card {
        border: 1px solid #e2e2e6;
        border-radius: 8px;
        margin-bottom: 0.75rem;
        overflow: hidden;
        background: #ffffff;
      }
      .msg-card.msg-unread {
        border-left: 3px solid #42168A;
      }
      .msg-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.75rem 1rem;
        cursor: pointer;
        gap: 0.75rem;
        -webkit-tap-highlight-color: transparent;
        min-height: 44px;
      }
      .msg-header:hover {
        background: #f8f9fa;
      }
      .msg-header-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
        flex: 1;
      }
      .msg-name {
        font-weight: 600;
        font-size: 0.875rem;
        color: #1a1a2e;
        white-space: nowrap;
      }
      .msg-reason {
        font-size: 0.75rem;
        color: #6b7280;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .msg-date {
        font-size: 0.6875rem;
        color: #9ca3af;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .msg-body {
        display: none;
        padding: 0 1rem 1rem;
        font-size: 0.875rem;
        line-height: 1.6;
        border-top: 1px solid #f0f0f4;
      }
      .msg-body.open {
        display: block;
      }
      .msg-body-inner {
        padding-top: 0.75rem;
      }
      .msg-field {
        margin-bottom: 0.625rem;
      }
      .msg-label {
        font-size: 0.6875rem;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.125rem;
        display: block;
      }
      .msg-value {
        color: #1a1a2e;
        font-size: 0.875rem;
      }
      .msg-value a {
        color: #42168A;
        text-decoration: none;
      }
      .msg-value a:hover {
        text-decoration: underline;
      }
      .msg-text {
        white-space: pre-wrap;
        background: #f8f9fa;
        padding: 0.75rem;
        border-radius: 6px;
        margin-top: 0.75rem;
        font-size: 0.8125rem;
        color: #1a1a2e;
        line-height: 1.6;
        border: 1px solid #f0f0f4;
      }
      .msg-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1rem;
      }
      .msg-actions button {
        font-size: 0.75rem;
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid #e2e2e6;
        background: #ffffff;
        color: #374151;
        min-height: 44px;
        min-width: 44px;
        -webkit-tap-highlight-color: transparent;
        font-weight: 500;
      }
      .msg-actions button:hover {
        border-color: #9ca3af;
        background: #f8f9fa;
      }
      .msg-actions .delete-btn {
        color: #991b1b;
        border-color: #fecaca;
      }
      .msg-actions .delete-btn:hover {
        background: #fef2f2;
        border-color: #f87171;
      }
    </style>
  </Fragment>
</AdminLayout>

<script is:inline>
(function() {
  var listEl = document.getElementById('msg-list');
  var countEl = document.getElementById('msg-count');
  var emptyEl = document.getElementById('msg-empty');
  var errorEl = document.getElementById('msg-error');

  function formatDate(iso) {
    var d = new Date(iso);
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) + ' at ' + d.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
  }

  function esc(str) {
    if (!str) return '';
    var el = document.createElement('span');
    el.textContent = str;
    return el.innerHTML;
  }

  async function loadList() {
    try {
      var res = await fetch('/api/admin/messages/');
      if (!res.ok) throw new Error('Could not load messages.');
      var data = await res.json();
      var messages = data.messages || [];

      if (messages.length === 0) {
        emptyEl.style.display = '';
        countEl.textContent = '0 messages';
        return;
      }

      var unread = messages.filter(function(m) { return !m.read; }).length;
      countEl.textContent = messages.length + ' message' + (messages.length === 1 ? '' : 's') + (unread > 0 ? ' (' + unread + ' unread)' : '');

      listEl.innerHTML = messages.map(function(m) {
        return '<div class="msg-card' + (!m.read ? ' msg-unread' : '') + '" data-id="' + esc(m.id) + '">' +
          '<div class="msg-header" onclick="toggleMsg(this)">' +
            '<div class="msg-header-left">' +
              '<span class="msg-name">' + esc(m.name || 'No name') + '</span>' +
              (m.reason ? ' <span class="msg-reason">' + esc(m.reason) + '</span>' : '') +
            '</div>' +
            '<span class="msg-date">' + (m.submitted_at ? formatDate(m.submitted_at) : '') + '</span>' +
          '</div>' +
          '<div class="msg-body"><div class="msg-body-inner">Loading...</div></div>' +
        '</div>';
      }).join('');
    } catch (err) {
      errorEl.textContent = err.message;
      errorEl.style.display = '';
    }
  }

  window.toggleMsg = async function(header) {
    var card = header.parentElement;
    var body = card.querySelector('.msg-body');
    if (body.classList.contains('open')) {
      body.classList.remove('open');
      return;
    }

    var id = card.getAttribute('data-id');
    var inner = body.querySelector('.msg-body-inner');

    if (inner && inner.textContent === 'Loading...') {
      try {
        var res = await fetch('/api/admin/messages/?id=' + encodeURIComponent(id));
        if (!res.ok) {
          inner.innerHTML = '<p style="color: #991b1b;">Could not load message.</p>';
          body.classList.add('open');
          return;
        }
        var msg = await res.json();

        var html = '';
        if (msg.pronouns) {
          html += '<div class="msg-field"><span class="msg-label">Pronouns</span><span class="msg-value">' + esc(msg.pronouns) + '</span></div>';
        }
        html += '<div class="msg-field"><span class="msg-label">Email</span><span class="msg-value"><a href="mailto:' + esc(msg.email) + '">' + esc(msg.email) + '</a></span></div>';
        if (msg.phone) {
          html += '<div class="msg-field"><span class="msg-label">Phone</span><span class="msg-value"><a href="tel:' + msg.phone.replace(/[^\d+]/g, '') + '">' + esc(msg.phone) + '</a></span></div>';
        }
        html += '<div class="msg-text">' + esc(msg.message) + '</div>';
        html += '<div class="msg-actions">';
        html += '<button onclick="toggleRead(\'' + esc(id) + '\', this)">' + (msg.read ? 'Mark unread' : 'Mark read') + '</button>';
        html += '<button class="delete-btn" onclick="deleteMsg(\'' + esc(id) + '\', this)">Delete</button>';
        html += '</div>';

        inner.innerHTML = html;

        if (!msg.read) {
          fetch('/api/admin/messages/?id=' + encodeURIComponent(id), { method: 'PUT' });
          card.classList.remove('msg-unread');
        }
      } catch (err) {
        inner.innerHTML = '<p style="color: #991b1b;">Error loading message.</p>';
      }
    }

    body.classList.add('open');
  };

  window.toggleRead = async function(id, btn) {
    var res = await fetch('/api/admin/messages/?id=' + encodeURIComponent(id), { method: 'PUT' });
    var data = await res.json();
    btn.textContent = data.read ? 'Mark unread' : 'Mark read';
    var card = btn.closest('.msg-card');
    if (data.read) card.classList.remove('msg-unread');
    else card.classList.add('msg-unread');
  };

  window.deleteMsg = async function(id, btn) {
    if (!confirm('Delete this message?')) return;
    await fetch('/api/admin/messages/?id=' + encodeURIComponent(id), { method: 'DELETE' });
    btn.closest('.msg-card').remove();
    var remaining = document.querySelectorAll('.msg-card').length;
    var unread = document.querySelectorAll('.msg-card.msg-unread').length;
    countEl.textContent = remaining + ' message' + (remaining === 1 ? '' : 's') + (unread > 0 ? ' (' + unread + ' unread)' : '');
    if (remaining === 0) emptyEl.style.display = '';
  };

  loadList();
})();
</script>
