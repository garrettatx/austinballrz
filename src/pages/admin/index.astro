---
import AdminLayout from '../../components/admin/AdminLayout.astro';
---

<AdminLayout title="Admin">
  <h1 class="admin-index-h1">Admin</h1>
  <p class="admin-index-sub">Tools for team managers and contributors.</p>

  <div class="admin-cards">
    <a href="/admin/photo/" class="admin-card">
      <div class="admin-card-content">
        <p class="admin-card-title">Submit a Photo</p>
        <p class="admin-card-desc">Upload team photos for review. No login needed.</p>
      </div>
      <svg class="admin-card-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    <a href="/admin/dashboard/messages/" class="admin-card">
      <div class="admin-card-content">
        <p class="admin-card-title"><span class="lock-label">&#x1f512;</span> Messages</p>
        <p class="admin-card-desc">View contact form submissions. Login required.</p>
      </div>
      <svg class="admin-card-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    <a href="/admin/dashboard/photos/" class="admin-card">
      <div class="admin-card-content">
        <p class="admin-card-title"><span class="lock-label">&#x1f512;</span> Photo Review</p>
        <p class="admin-card-desc">Review, approve, or reject submitted photos. Login required.</p>
      </div>
      <svg class="admin-card-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</AdminLayout>

<style>
  .admin-index-h1 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .admin-index-sub {
    color: #6b7280;
    font-size: 0.85rem;
    margin-bottom: 24px;
  }
  .admin-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .admin-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    border: 1px solid #e2e2e6;
    border-radius: 8px;
    text-decoration: none;
    color: #1a1a2e;
    transition: border-color 0.15s, box-shadow 0.15s;
    gap: 12px;
  }
  .admin-card:hover {
    border-color: #42168A;
    box-shadow: 0 1px 4px rgba(66, 22, 138, 0.08);
  }
  .admin-card:active {
    background: #faf8fd;
  }
  .admin-card-content {
    flex: 1;
    min-width: 0;
  }
  .admin-card-title {
    font-weight: 600;
    font-size: 0.9375rem;
    margin-bottom: 4px;
  }
  .admin-card-desc {
    font-size: 0.8125rem;
    color: #6b7280;
  }
  .admin-card-chevron {
    flex-shrink: 0;
    color: #9ca3af;
    transition: color 0.15s, transform 0.15s;
  }
  .admin-card:hover .admin-card-chevron {
    color: #42168A;
    transform: translateX(2px);
  }
  .lock-label {
    font-size: 0.75rem;
  }
</style>
