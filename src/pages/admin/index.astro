---
import AdminLayout from '../../components/admin/AdminLayout.astro';
---

<AdminLayout title="Admin">
  <h1 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 0.125rem;">Admin</h1>
  <p style="color: #6b7280; font-size: 0.85rem; margin-bottom: 1.5rem;">Tools for team managers and contributors.</p>

  <div style="display: flex; flex-direction: column; gap: 0.75rem;">
    <a href="/admin/photo/" style="display: block; padding: 1rem; border: 1px solid #e2e2e6; border-radius: 8px; text-decoration: none; color: #1a1a2e; transition: border-color 0.15s;">
      <p style="font-weight: 600; font-size: 0.9375rem; margin-bottom: 0.25rem;">Submit a Photo</p>
      <p style="font-size: 0.8125rem; color: #6b7280;">Upload team photos for review. No login needed.</p>
    </a>

    <a href="/admin/dashboard/messages/" style="display: block; padding: 1rem; border: 1px solid #e2e2e6; border-radius: 8px; text-decoration: none; color: #1a1a2e; transition: border-color 0.15s;">
      <p style="font-weight: 600; font-size: 0.9375rem; margin-bottom: 0.25rem;">🔒 Messages</p>
      <p style="font-size: 0.8125rem; color: #6b7280;">View contact form submissions. Login required.</p>
    </a>

    <a href="/admin/dashboard/photos/" style="display: block; padding: 1rem; border: 1px solid #e2e2e6; border-radius: 8px; text-decoration: none; color: #1a1a2e; transition: border-color 0.15s;">
      <p style="font-weight: 600; font-size: 0.9375rem; margin-bottom: 0.25rem;">🔒 Photo Management</p>
      <p style="font-size: 0.8125rem; color: #6b7280;">Review, approve, or reject submitted photos. Login required.</p>
    </a>
  </div>
</AdminLayout>

<style>
  a:hover { border-color: #42168A !important; }
</style>
