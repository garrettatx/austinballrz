---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import PhotoRow from '../../components/PhotoRow.astro';
import { site } from '../../data/site';

const breadcrumbs = [{ label: 'Admin' }];
---

<Layout
  title={`Admin | ${site.titleSuffix}`}
  description="Tools for team managers and contributors."
  noindex
>
  <Header slot="header" />

  <PageHeader
    title="Admin"
    description="Tools for team managers and contributors."
    breadcrumbs={breadcrumbs}
  />

  <section class="section-sm">
    <div class="container">
      <div class="admin-cards">
        <a href="/admin/photo/" class="admin-card">
          <div class="admin-card-content">
            <p class="admin-card-title">Submit a Photo</p>
            <p class="admin-card-desc">Upload team photos for review. No login needed.</p>
          </div>
          <svg class="admin-card-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <a href="/admin/dashboard/photos/" class="admin-card">
          <div class="admin-card-content">
            <p class="admin-card-title"><span class="lock-label">&#x1f512;</span> Photo Review</p>
            <p class="admin-card-desc">Review, approve, or reject submitted photos. Login required.</p>
          </div>
          <svg class="admin-card-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <a href="/admin/dashboard/messages/" class="admin-card">
          <div class="admin-card-content">
            <p class="admin-card-title"><span class="lock-label">&#x1f512;</span> Messages</p>
            <p class="admin-card-desc">Contact form backup. Login required.</p>
          </div>
          <svg class="admin-card-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <div class="admin-section">
        <p class="label" style="margin-bottom: var(--space-3);">Unlisted Pages</p>
        <p class="admin-section-desc">These pages are not linked from the main site navigation. They are noindex/nofollow and only shared directly.</p>
        <div class="admin-cards">
          <a href="/join/" class="admin-card">
            <div class="admin-card-content">
              <p class="admin-card-title">Join the Team</p>
              <p class="admin-card-desc">New player guide with interest form. Shared with prospective players.</p>
            </div>
            <svg class="admin-card-chevron" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M7.5 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <PhotoRow />

  <Footer slot="footer" />
</Layout>

<style>
  .admin-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 520px;
  }
  .admin-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    border: 1px solid var(--color-border, #e2e2e6);
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text);
    transition: border-color 0.15s, box-shadow 0.15s;
    gap: 12px;
  }
  .admin-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 1px 4px rgba(66, 22, 138, 0.08);
  }
  .admin-card:active {
    background: #faf8fd;
  }
  .admin-card-content {
    flex: 1;
    min-width: 0;
  }
  .admin-card-title {
    font-weight: 600;
    font-size: 0.9375rem;
    margin-bottom: 4px;
  }
  .admin-card-desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .admin-card-chevron {
    flex-shrink: 0;
    color: var(--color-muted);
    transition: color 0.15s, transform 0.15s;
  }
  .admin-card:hover .admin-card-chevron {
    color: var(--color-accent);
    transform: translateX(2px);
  }
  .lock-label {
    font-size: 0.75rem;
  }
  .admin-section {
    margin-top: var(--space-8);
    max-width: 520px;
  }
  .admin-section-desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-3);
  }
</style>
