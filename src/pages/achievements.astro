---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageNav from '../components/PageNav.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoRow from '../components/PhotoRow.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Achievements' }];

const years = [
  { year: '2026', season: [], tournaments: ['Dallas Tournament — D Team'] },
  { year: '2025', season: ['D Division Spring — 3rd Place', 'E Division Spring — 2nd Place'], tournaments: ['Dallas Tournament — D Team', 'Houston Tournament — D Team'] },
  { year: '2024', season: ['D Division Spring', 'E Division Spring'], tournaments: ['iPride World Series — Las Vegas'] },
  { year: '2023', season: ['E Division Spring — 2nd Place'], tournaments: ['Vegas — E Division 3rd Place', 'Dallas — E Division 2nd Place', 'Austin — E Division 4th Place', 'iPride World Series — Minneapolis'] },
  { year: '2022', season: ['E Division Fall — 1st Place', 'E Division Spring — 1st Place'], tournaments: ['Houston — E Division 4th Place', 'NAGAAA GSWS Dallas — 13th of 33 teams'] },
  { year: '2021', season: ['E Division Fall — 2nd Place', 'E Division Spring — 2nd Place'], tournaments: ['NAGAAA GSWS Columbus — 13th of 30 teams'] },
  { year: '2019', season: ['D Division Fall — 1st Place', 'E Division Spring'], tournaments: ['NAGAAA World Series Kansas City — EZ Ball\'rz 4th Place'] },
];
---

<Layout
  title={`Achievements | ${site.name}`}
  description="Austin Ball'rz softball team achievements, tournament results, and league standings from 2013 to present."
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Achievements"
    description="League standings and tournament results."
    breadcrumbs={breadcrumbs}
  />

  <section class="section-sm">
    <div class="container">
      <div class="content-width" style="display: flex; flex-direction: column; gap: var(--space-8);">
        {years.map(y => (
          <div class="border-b border-[var(--color-border)] pb-6 last:border-b-0">
            <h2 class="heading h4" style="margin-bottom: var(--space-3);">{y.year}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <p class="label" style="margin-bottom: var(--space-2);">Regular Season</p>
                <ul class="space-y-1">
                  {y.season.map(s => (
                    <li style="font-size: var(--text-sm);">{s}</li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="label" style="margin-bottom: var(--space-2);">Tournaments</p>
                <ul class="space-y-1">
                  {y.tournaments.map(t => (
                    <li style="font-size: var(--text-sm);">{t}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <PhotoRow />

  <PageNav currentPath="/achievements/" />

  <Footer slot="footer" />
</Layout>
