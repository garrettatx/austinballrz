---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Sponsors' }];
---

<Layout
  title={`Sponsors | ${site.name}`}
  description="Sponsor the Austin Ball'rz LGBTQ+ softball team. Packages from $250 to $2,500."
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Become a Sponsor"
    description="Support LGBTQ+ athletics in Austin. Your sponsorship helps cover league fees, tournament travel, uniforms, and equipment."
    breadcrumbs={breadcrumbs}
  />

  <section class="pb-12">
    <div class="max-w-5xl mx-auto px-6">

      <!-- Sponsorship diamond — baseball diamond layout -->
      <!-- Home plate (champion) at bottom, 2nd base (captain) at top, 1st/3rd on sides -->
      <div class="flex justify-center mb-10">
        <div class="relative" style="width: 320px; height: 320px;">
          <!-- Outer diamond frame with base dots -->
          <div class="absolute" style="width: 226px; height: 226px; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(45deg); border: 2px solid rgba(66,22,138,0.15); border-radius: 4px;"></div>
          <!-- Base dots -->
          <div class="absolute w-2.5 h-2.5 rounded-full bg-[var(--ballrz-purple)]/30" style="top: 4px; left: 50%; transform: translateX(-50%);"></div>
          <div class="absolute w-2.5 h-2.5 rounded-full bg-[var(--ballrz-purple)]/30" style="bottom: 4px; left: 50%; transform: translateX(-50%);"></div>
          <div class="absolute w-2.5 h-2.5 rounded-full bg-[var(--ballrz-purple)]/30" style="top: 50%; left: 4px; transform: translateY(-50%);"></div>
          <div class="absolute w-2.5 h-2.5 rounded-full bg-[var(--ballrz-purple)]/30" style="top: 50%; right: 4px; transform: translateY(-50%);"></div>

          <!-- 2nd base — Team Captain $500 (top) -->
          <div class="absolute text-white text-center" style="width: 120px; height: 120px; top: 18px; left: 50%; transform: translateX(-50%) rotate(45deg);">
            <div class="w-full h-full bg-[#3d4466] rounded-sm flex items-center justify-center">
              <div style="transform: rotate(-45deg);">
                <p class="text-lg font-bold leading-tight" style="font-family: var(--font-heading);">$500</p>
                <p class="text-[8px] uppercase tracking-widest text-white/50 mt-0.5" style="font-family: var(--font-heading);">Team Captain</p>
              </div>
            </div>
          </div>

          <!-- 3rd base — MVP $1,000 (left) -->
          <div class="absolute text-white text-center" style="width: 120px; height: 120px; top: 50%; left: 18px; transform: translateY(-50%) rotate(45deg);">
            <div class="w-full h-full bg-[#3d4466] rounded-sm flex items-center justify-center">
              <div style="transform: rotate(-45deg);">
                <p class="text-lg font-bold leading-tight" style="font-family: var(--font-heading);">$1,000</p>
                <p class="text-[8px] uppercase tracking-widest text-white/50 mt-0.5" style="font-family: var(--font-heading);">MVP</p>
              </div>
            </div>
          </div>

          <!-- 1st base — Slugger $250 (right) -->
          <div class="absolute text-white text-center" style="width: 120px; height: 120px; top: 50%; right: 18px; transform: translateY(-50%) rotate(45deg);">
            <div class="w-full h-full bg-[#3d4466] rounded-sm flex items-center justify-center">
              <div style="transform: rotate(-45deg);">
                <p class="text-lg font-bold leading-tight" style="font-family: var(--font-heading);">$250</p>
                <p class="text-[8px] uppercase tracking-widest text-white/50 mt-0.5" style="font-family: var(--font-heading);">Slugger</p>
              </div>
            </div>
          </div>

          <!-- Home plate — Champion $2,500 (bottom, highlighted) -->
          <div class="absolute text-white text-center" style="width: 120px; height: 120px; bottom: 18px; left: 50%; transform: translateX(-50%) rotate(45deg);">
            <div class="w-full h-full bg-[var(--ballrz-purple)] rounded-sm flex items-center justify-center">
              <div style="transform: rotate(-45deg);">
                <p class="text-lg font-bold leading-tight" style="font-family: var(--font-heading);">$2,500</p>
                <p class="text-[8px] uppercase tracking-widest text-white/50 mt-0.5" style="font-family: var(--font-heading);">Champion</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Details -->
      <div class="max-w-2xl space-y-6">
        <p class="text-[var(--ballrz-gray-600)] leading-relaxed text-[0.95rem]">
          All sponsors receive recognition on the team's dugout banner at tournaments, plus visibility on the website and social media. Higher tiers include logo placement on team jerseys and VIP seating.
        </p>

        <div>
          <h2 class="text-lg font-bold text-[var(--ballrz-dark)] mb-2" style="font-family: var(--font-heading);">Interested?</h2>
          <p class="text-[var(--ballrz-gray-600)] text-[0.95rem] mb-4">We'd love to hear from you. Reach out and we'll send over the full sponsorship packet.</p>
          <a href="/contact/" class="inline-block px-5 py-2.5 bg-[var(--ballrz-purple)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--ballrz-purple-dark)] transition-colors" style="font-family: var(--font-heading); letter-spacing: 0.04em;">
            Contact Us
          </a>
        </div>
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</Layout>
