---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageNav from '../components/PageNav.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoRow from '../components/PhotoRow.astro';
import PlayCTA from '../components/PlayCTA.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Sponsors' }];

const tiers = [
  { name: 'Champion', price: '$2,500', benefit: 'Logo on jerseys, banner, website, and social media. VIP seating.', highlight: true },
  { name: 'MVP', price: '$1,000', benefit: 'Logo on dugout banner, website, and social media.' },
  { name: 'Team Captain', price: '$500', benefit: 'Social media recognition and name on website.' },
  { name: 'Slugger', price: '$250', benefit: 'Social media recognition and name on website.' },
];
---

<Layout
  title={`Become a Sponsor | ${site.titleSuffix}`}
  description="Support LGBTQ+ inclusive softball in Austin. Sponsorship packages from $250 to $2,500 — jerseys, banners, and more."
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Become a Sponsor"
    description="Your sponsorship helps cover league fees, tournament travel, uniforms, and equipment."
    breadcrumbs={breadcrumbs}
  />

  <section class="section-sm">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] items-start" style={`gap: var(--space-12);`}>

        {/* Diamond graphic — desktop only */}
        <div class="hidden lg:block">
          <div class="relative" style="width: 420px; height: 420px;">
            <svg class="absolute inset-0 w-full h-full overflow-visible" viewBox="0 0 420 420" fill="none" aria-hidden="true">
              <rect x="60" y="60" width="300" height="300" rx="3" transform="rotate(45 210 210)" stroke="rgba(160,155,210,0.4)" stroke-width="2.5" />
              <circle cx="210" cy="0" r="12" fill="rgba(160,155,210,0.5)" />
              <circle cx="210" cy="420" r="12" fill="rgba(160,155,210,0.5)" />
              <circle cx="0" cy="210" r="12" fill="rgba(160,155,210,0.5)" />
              <circle cx="420" cy="210" r="12" fill="rgba(160,155,210,0.5)" />
            </svg>

            {/* Top — Team Captain $500 */}
            <div class="absolute text-white text-center" style="width: 135px; height: 135px; top: 35px; left: 50%; transform: translateX(-50%) rotate(45deg);">
              <div class="w-full h-full rounded flex items-center justify-center" style="background: var(--color-primary);">
                <div style="transform: rotate(-45deg);">
                  <p class="heading" style="font-size: 1.25rem; font-weight: 700; color: white;">$500</p>
                  <p class="label" style="color: rgba(255,255,255,0.6); margin-top: 2px; font-size: 0.65rem;">Team Captain</p>
                </div>
              </div>
            </div>

            {/* Left — MVP $1,000 */}
            <div class="absolute text-white text-center" style="width: 135px; height: 135px; top: 50%; left: 35px; transform: translateY(-50%) rotate(45deg);">
              <div class="w-full h-full rounded flex items-center justify-center" style="background: var(--color-primary);">
                <div style="transform: rotate(-45deg);">
                  <p class="heading" style="font-size: 1.25rem; font-weight: 700; color: white;">$1,000</p>
                  <p class="label" style="color: rgba(255,255,255,0.6); margin-top: 2px; font-size: 0.65rem;">MVP</p>
                </div>
              </div>
            </div>

            {/* Right — Slugger $250 */}
            <div class="absolute text-white text-center" style="width: 135px; height: 135px; top: 50%; right: 35px; transform: translateY(-50%) rotate(45deg);">
              <div class="w-full h-full rounded flex items-center justify-center" style="background: var(--color-primary);">
                <div style="transform: rotate(-45deg);">
                  <p class="heading" style="font-size: 1.25rem; font-weight: 700; color: white;">$250</p>
                  <p class="label" style="color: rgba(255,255,255,0.6); margin-top: 2px; font-size: 0.65rem;">Slugger</p>
                </div>
              </div>
            </div>

            {/* Bottom — Champion $2,500 (highlighted) */}
            <div class="absolute text-white text-center" style="width: 135px; height: 135px; bottom: 35px; left: 50%; transform: translateX(-50%) rotate(45deg);">
              <div class="w-full h-full rounded flex items-center justify-center" style="background: var(--color-accent);">
                <div style="transform: rotate(-45deg);">
                  <p class="heading" style="font-size: 1.25rem; font-weight: 700; color: white;">$2,500</p>
                  <p class="label" style="color: rgba(255,255,255,0.7); margin-top: 2px; font-size: 0.65rem;">Champion</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Tier details + CTA */}
        <div>
          <h2 class="heading h3" style={`margin-bottom: var(--space-6);`}>Sponsorship Levels</h2>

          <div style={`display: flex; flex-direction: column; gap: var(--space-4);`}>
            {tiers.map(tier => (
              <div
                class="rounded-lg"
                style={`padding: var(--space-4) var(--space-6); border: 1px solid var(--color-border); `}
              >
                <div class="flex items-baseline justify-between" style={`margin-bottom: var(--space-1);`}>
                  <h3 class="heading h4">{tier.name}</h3>
                  <span class="heading" style={`font-size: var(--text-xl); color: ${tier.highlight ? 'var(--color-accent)' : 'var(--color-primary)'};`}>{tier.price}</span>
                </div>
                <p style="font-size: var(--text-sm);">{tier.benefit}</p>
              </div>
            ))}
          </div>

          <div style={`margin-top: var(--space-8);`}>
            <p style={`margin-bottom: var(--space-4);`}>
              All sponsors get recognition on our dugout banner at tournaments plus visibility on the website and social media.
            </p>
            <a href="/contact/" class="btn btn-primary">Get in Touch</a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <PlayCTA />

  <PhotoRow />

  <PageNav currentPath="/sponsors/" />

  <Footer slot="footer" />
</Layout>
