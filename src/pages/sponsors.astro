---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Sponsors' }];
---

<Layout
  title={`Sponsors | ${site.name}`}
  description="Sponsor the Austin Ball'rz LGBTQ+ softball team. Packages from $250 to $2,500."
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Become a Sponsor"
    description="Support LGBTQ+ athletics in Austin. Your sponsorship helps cover league fees, tournament travel, uniforms, and equipment."
    breadcrumbs={breadcrumbs}
  />

  <section class="pb-12">
    <div class="max-w-5xl mx-auto px-6">

      <!-- Sponsorship diamond — baseball diamond layout -->
      <div class="flex justify-center mb-10">
        <div class="relative" style="width: 520px; height: 520px;">
          <!-- Outer diamond frame — wraps around the 4 tiles, slightly larger -->
          <div class="absolute" style="width: 390px; height: 390px; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(45deg); border: 2px solid rgba(160,155,210,0.4);"></div>
          <!-- Base dots at the 4 corners of the outer frame -->
          <div class="absolute rounded-full" style="width: 26px; height: 26px; background: rgba(160,155,210,0.5); top: -16px; left: 50%; transform: translateX(-50%);"></div>
          <div class="absolute rounded-full" style="width: 26px; height: 26px; background: rgba(160,155,210,0.5); bottom: -16px; left: 50%; transform: translateX(-50%);"></div>
          <div class="absolute rounded-full" style="width: 26px; height: 26px; background: rgba(160,155,210,0.5); top: 50%; left: -16px; transform: translateY(-50%);"></div>
          <div class="absolute rounded-full" style="width: 26px; height: 26px; background: rgba(160,155,210,0.5); top: 50%; right: -16px; transform: translateY(-50%);"></div>

          <!-- 2nd base — Team Captain $500 (top) -->
          <div class="absolute text-white text-center" style="width: 165px; height: 165px; top: 50px; left: 50%; transform: translateX(-50%) rotate(45deg);">
            <div class="w-full h-full bg-[#3d4466] rounded flex items-center justify-center">
              <div style="transform: rotate(-45deg);">
                <p class="text-2xl font-bold leading-tight" style="font-family: var(--font-heading);">$500</p>
                <p class="text-[11px] uppercase tracking-wider text-white/60 mt-1" style="font-family: var(--font-heading);">Team Captain Level</p>
              </div>
            </div>
          </div>

          <!-- 3rd base — MVP $1,000 (left) -->
          <div class="absolute text-white text-center" style="width: 165px; height: 165px; top: 50%; left: 50px; transform: translateY(-50%) rotate(45deg);">
            <div class="w-full h-full bg-[#3d4466] rounded flex items-center justify-center">
              <div style="transform: rotate(-45deg);">
                <p class="text-2xl font-bold leading-tight" style="font-family: var(--font-heading);">$1,000</p>
                <p class="text-[11px] uppercase tracking-wider text-white/60 mt-1" style="font-family: var(--font-heading);">MVP Level</p>
              </div>
            </div>
          </div>

          <!-- 1st base — Slugger $250 (right) -->
          <div class="absolute text-white text-center" style="width: 165px; height: 165px; top: 50%; right: 50px; transform: translateY(-50%) rotate(45deg);">
            <div class="w-full h-full bg-[#3d4466] rounded flex items-center justify-center">
              <div style="transform: rotate(-45deg);">
                <p class="text-2xl font-bold leading-tight" style="font-family: var(--font-heading);">$250</p>
                <p class="text-[11px] uppercase tracking-wider text-white/60 mt-1" style="font-family: var(--font-heading);">Slugger Level</p>
              </div>
            </div>
          </div>

          <!-- Home plate — Champion $2,500 (bottom, highlighted) -->
          <div class="absolute text-white text-center" style="width: 165px; height: 165px; bottom: 50px; left: 50%; transform: translateX(-50%) rotate(45deg);">
            <div class="w-full h-full bg-[#3d4466] rounded flex items-center justify-center">
              <div style="transform: rotate(-45deg);">
                <p class="text-2xl font-bold leading-tight" style="font-family: var(--font-heading);">$2,500</p>
                <p class="text-[11px] uppercase tracking-wider text-white/60 mt-1" style="font-family: var(--font-heading);">Championship Level</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Details -->
      <div class="max-w-2xl space-y-6">
        <p class="text-[var(--ballrz-gray-600)] leading-relaxed text-[0.95rem]">
          All sponsors receive recognition on the team's dugout banner at tournaments, plus visibility on the website and social media. Higher tiers include logo placement on team jerseys and VIP seating.
        </p>

        <div>
          <h2 class="text-lg font-bold text-[var(--ballrz-dark)] mb-2" style="font-family: var(--font-heading);">Interested?</h2>
          <p class="text-[var(--ballrz-gray-600)] text-[0.95rem] mb-4">We'd love to hear from you. Reach out and we'll send over the full sponsorship packet.</p>
          <a href="/contact/" class="inline-block px-5 py-2.5 bg-[var(--ballrz-purple)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--ballrz-purple-dark)] transition-colors" style="font-family: var(--font-heading); letter-spacing: 0.04em;">
            Contact Us
          </a>
        </div>
      </div>

    </div>
  </section>

  <Footer slot="footer" />
</Layout>
