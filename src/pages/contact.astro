---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageNav from '../components/PageNav.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoRow from '../components/PhotoRow.astro';
import { site } from '../data/site';
import { playing } from '../data/playing';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Contact' }];
const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY;
---

<Layout
  title={`Contact Us | ${site.name}`}
  description="Get in touch with the Austin Ball'rz. Want to play or sponsor a team?"
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Contact Us"
    description="Want to play softball or sponsor a team? Here's how to reach us."
    breadcrumbs={breadcrumbs}
  />

  <section class="section-sm">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] items-start" style={`gap: var(--space-12);`}>

        {/* Contact form — shows first on mobile (source order), second on desktop (grid order) */}
        <div class="order-1 lg:order-2">
          <h2 id="contact-form-top" class="heading h4 mb-4">Send Us a Message</h2>

          {/* Success message (hidden by default) */}
          <div id="form-success" class="hidden rounded-lg mb-4" style={`padding: var(--space-4); background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46;`}>
            <p class="font-semibold">Message sent.</p>
            <p style="font-size: var(--text-sm);">We'll get back to you within a day or two.</p>
          </div>

          {/* Error message (hidden by default) */}
          <div id="form-error" class="hidden rounded-lg mb-4" style={`padding: var(--space-4); background: #fef2f2; border: 1px solid #fecaca; color: #991b1b;`}>
            <p id="form-error-text">Something went wrong. Please try again.</p>
          </div>

          <form id="contact-form" class="stack stack-md">
            {/* Honeypot — hidden from humans */}
            <div style="position: absolute; left: -9999px;" aria-hidden="true">
              <label for="website_url">Website</label>
              <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off" />
            </div>

            <div>
              <label for="name" class="label mb-1" style="display: block; color: var(--color-dark);">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="w-full rounded-lg transition-colors"
                style={`padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border); font-size: var(--text-base); font-family: var(--font-body);`}
              />
            </div>

            <div>
              <label for="email" class="label mb-1" style="display: block; color: var(--color-dark);">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full rounded-lg transition-colors"
                style={`padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border); font-size: var(--text-base); font-family: var(--font-body);`}
              />
            </div>

            <div>
              <label for="phone" class="label mb-1" style="display: block; color: var(--color-dark);">Phone</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                autocomplete="tel"
                class="w-full rounded-lg transition-colors"
                style={`padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border); font-size: var(--text-base); font-family: var(--font-body);`}
              />
            </div>

            <div>
              <label for="reason" class="label mb-1" style="display: block; color: var(--color-dark);">What Brings You Here?</label>
              <select
                id="reason"
                name="reason"
                class="w-full rounded-lg transition-colors"
                style={`padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border); font-size: var(--text-base); font-family: var(--font-body); background: white;`}
              >
                <option value="Want to play">Want to play</option>
                <option value="Sponsorship">Sponsorship</option>
                <option value="General question">General question</option>
              </select>
            </div>

            <div>
              <label for="message" class="label mb-1" style="display: block; color: var(--color-dark);">Message</label>
              <textarea
                id="message"
                name="message"
                required
                rows="4"
                class="w-full rounded-lg transition-colors"
                style={`padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border); font-size: var(--text-base); font-family: var(--font-body); resize: vertical;`}
              ></textarea>
            </div>

            {/* Turnstile */}
            {turnstileSiteKey && (
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} style="min-height: 65px;"></div>
            )}

            <div>
              <button type="submit" id="submit-btn" class="btn btn-primary w-full text-center">
                Send Message
              </button>
            </div>
          </form>

          {/* Hint to scroll down on mobile */}
          <p class="lg:hidden text-center" style="margin-top: var(--space-3); font-size: var(--text-sm);">
            <a href="#playing-info" style="color: var(--color-muted);">Info about playing, seasons & joining &darr;</a>
          </p>
        </div>

        {/* Playing info — shows second on mobile, first on desktop */}
        <div id="playing-info" class="stack stack-lg order-2 lg:order-1">

          <div>
            <h2 class="heading h4 mb-3">Want to Play?</h2>
            <p class="mb-3">
              We've had a team every season since 2013. {playing.seasons} {playing.gameDay} Games are at <a href={playing.fieldUrl} class="text-[var(--color-accent)] hover:underline">{playing.field}</a> in {playing.fieldCity}.
            </p>

            <h3 class="heading h4 mb-2">Skill Levels</h3>
            <ul class="list-spaced mb-3">
              {playing.divisions.map(div => (
                <li><strong>{div.name}</strong> — {div.description}</li>
              ))}
            </ul>

            <h3 class="heading h4 mb-2">Practice</h3>
            <p class="mb-3">
              During the spring season, we practice on weeknights at <a href={playing.fieldUrl} class="text-[var(--color-accent)] hover:underline">{playing.field}</a> or <a href={playing.practiceFieldUrl} class="text-[var(--color-accent)] hover:underline">{playing.practiceField}</a> in {playing.practiceCity}. We practice when we have a game the following weekend. Fall is more casual — just Sunday games, no weeknight practices.
            </p>

            <h3 class="heading h4 mb-2">Joining</h3>
            <p class="mb-3">
              {playing.joiningNote}
            </p>

            <h3 class="heading h4 mb-2">More Than Games</h3>
            <p>
              {playing.socialNote}
            </p>
          </div>

          <div>
            <h2 class="heading h4 mb-3">Want to Sponsor?</h2>
            <p>
              Sponsorship packages start at $250. <a href="/sponsors/" class="text-[var(--color-accent)] hover:underline">See our sponsorship levels</a> or send us a message.
            </p>
          </div>

          {/* Jump to form — mobile only */}
          <div class="lg:hidden" style="margin-top: var(--space-4);">
            <a href="#contact-form-top" class="btn btn-primary w-full text-center">Send Us a Message</a>
          </div>

        </div>

      </div>
    </div>
  </section>

  {/* Turnstile script */}
  {turnstileSiteKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
  )}

  <script is:inline>
  (function() {
    var form = document.getElementById('contact-form');
    var btn = document.getElementById('submit-btn');
    var successEl = document.getElementById('form-success');
    var errorEl = document.getElementById('form-error');
    var errorText = document.getElementById('form-error-text');
    if (!form || !btn) return;

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      // Check honeypot
      var honeypot = document.getElementById('website_url');
      if (honeypot && honeypot.value) {
        successEl.classList.remove('hidden');
        form.classList.add('hidden');
        return;
      }

      // Disable button
      btn.disabled = true;
      btn.textContent = 'Sending...';
      errorEl.classList.add('hidden');

      // Get Turnstile token
      var turnstileToken = '';
      var turnstileInput = form.querySelector('[name="cf-turnstile-response"]');
      if (turnstileInput) turnstileToken = turnstileInput.value;

      // Validate Turnstile
      if (document.querySelector('.cf-turnstile') && !turnstileToken) {
        errorText.textContent = 'Please complete the security check.';
        errorEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Send Message';
        return;
      }

      try {
        var res = await fetch('/api/contact/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: form.name.value,
            email: form.email.value,
            phone: form.phone.value,
            reason: form.reason.value,
            message: form.message.value,
            turnstileToken: turnstileToken,
            honeypot: honeypot ? honeypot.value : '',
          }),
        });

        var data = await res.json();

        if (data.success) {
          successEl.classList.remove('hidden');
          form.classList.add('hidden');
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });

          // Track conversion
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'generate_lead', {
              currency: 'USD',
              value: 0,
              lead_type: form.reason.value,
            });
          }
        } else {
          errorText.textContent = data.error || 'Something went wrong. Please try again.';
          errorEl.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'Send Message';
        }
      } catch (err) {
        errorText.textContent = 'Could not send message. Please try again.';
        errorEl.classList.remove('hidden');
        btn.disabled = false;
        btn.textContent = 'Send Message';
      }
    });
  })();
  </script>

  <PhotoRow />

  <PageNav currentPath="/contact/" />

  <Footer slot="footer" />
</Layout>

<style>
  input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(66, 22, 138, 0.1);
  }
</style>
