---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageNav from '../components/PageNav.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Contact' }];
---

<Layout
  title={`Contact Us | ${site.name}`}
  description="Get in touch with the Austin Ball'rz. Want to play, sponsor, or just say hey?"
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Contact Us"
    description="Want to play, sponsor, or just say hey? Here's how to reach us."
    breadcrumbs={breadcrumbs}
  />

  <section class="section-sm">
    <div class="container">
      <div class="prose-width" style={`display: flex; flex-direction: column; gap: var(--space-8);`}>

        <div>
          <h2 class="heading h4" style={`margin-bottom: var(--space-3);`}>Get in Touch</h2>
          <p style={`margin-bottom: var(--space-4);`}>
            The best way to reach us is through our <a href={site.social.facebook} class="text-[var(--color-accent)] hover:underline">Facebook page</a>. Any of our coaches will be glad to talk and answer your questions. We typically respond within a day or two.
          </p>
        </div>

        <div>
          <h2 class="heading h4" style={`margin-bottom: var(--space-3);`}>Want to Play?</h2>
          <p style={`margin-bottom: var(--space-3);`}>
            We've had a team every season since 2013 — two seasons a year, spring and fall. Games are on Sunday mornings and afternoons at <a href="https://maps.google.com/?q=Krieg+Field+Austin+TX" class="text-[var(--color-accent)] hover:underline">Krieg Field</a> in Austin.
          </p>

          <h3 class="heading" style={`font-size: var(--text-lg); font-weight: 600; margin-bottom: var(--space-2);`}>Skill Levels</h3>
          <ul style={`display: flex; flex-direction: column; gap: var(--space-2); padding-left: var(--space-6); margin-bottom: var(--space-3);`} class="list-disc">
            <li><strong>D Division</strong> — for players with more experience and competitive play.</li>
            <li><strong>E Division</strong> — for newer players or those still building their game. No experience needed. The E team is a great place to start — we're all learning and growing together.</li>
          </ul>

          <h3 class="heading" style={`font-size: var(--text-lg); font-weight: 600; margin-bottom: var(--space-2);`}>Practice</h3>
          <p style={`margin-bottom: var(--space-3);`}>
            During the spring season, we practice on weeknights at <a href="https://maps.google.com/?q=Krieg+Field+Austin+TX" class="text-[var(--color-accent)] hover:underline">Krieg Field</a> or <a href="https://maps.google.com/?q=Southeast+Metropolitan+Park+Del+Valle+TX" class="text-[var(--color-accent)] hover:underline">Southeast Metro Field</a> in Del Valle (off Hwy 71, just past the airport). We practice when we have a game the following weekend. Fall is more casual — just Sunday games, no weeknight practices.
          </p>

          <h3 class="heading" style={`font-size: var(--text-lg); font-weight: 600; margin-bottom: var(--space-2);`}>Joining</h3>
          <p style={`margin-bottom: var(--space-3);`}>
            Reach out and one of our coaches will walk you through it. You'll register through <a href="https://www.softballaustin.org/" class="text-[var(--color-accent)] hover:underline">Softball Austin</a> — it's a straightforward process. There's a league registration fee and a team fee that covers practice fields, jerseys, and equipment.
          </p>

          <h3 class="heading" style={`font-size: var(--text-lg); font-weight: 600; margin-bottom: var(--space-2);`}>More Than Games</h3>
          <p>
            We do social events outside of Sunday games too. It's a great way to meet people and be part of a community — no bar required. Players and allies welcome.
          </p>
        </div>

        <div>
          <h2 class="heading h4" style={`margin-bottom: var(--space-3);`}>Want to Sponsor?</h2>
          <p>
            Sponsorship packages start at $250 and help cover league fees, tournament travel, and equipment. <a href="/sponsors/" class="text-[var(--color-accent)] hover:underline">See our sponsorship levels</a> or reach out to talk about it.
          </p>
        </div>

      </div>
    </div>
  </section>

  <PageNav currentPath="/contact/" />

  <Footer slot="footer" />
</Layout>
