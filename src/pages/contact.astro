---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Contact' }];
---

<Layout
  title={`Contact Us | ${site.name}`}
  description="Get in touch with the Austin Ball'rz. Interested in joining, sponsoring, or just have questions?"
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Contact Us"
    description="Want to play, sponsor, or just say hey? Here's how to reach us."
    breadcrumbs={breadcrumbs}
  />

  <section class="section-sm">
    <div class="container">
      <div class="prose-width space-y-6">
        <div>
          <h2 class="heading h4" style="margin-bottom: var(--space-2);">Get in Touch</h2>
          <p style={`margin-bottom: var(--space-4);`}>
            The best way to reach us is through our Facebook page or by emailing the team directly. We typically respond within a day or two.
          </p>
          {site.social.facebook && (
            <a href={site.social.facebook} class="btn btn-primary">
              Message Us on Facebook
            </a>
          )}
        </div>

        <div>
          <h2 class="heading h4" style="margin-bottom: var(--space-2);">Want to Play?</h2>
          <p>
            All skill levels, all good. Players and allies welcome. Send us a message and we'll tell you about upcoming practices and how to get involved with <a href="https://www.softballaustin.org/" class="text-[var(--color-accent)] hover:underline">Softball Austin</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
