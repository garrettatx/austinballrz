---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Contact' }];
---

<Layout
  title={`Contact Us | ${site.name}`}
  description="Get in touch with the Austin Ball'rz. Interested in joining, sponsoring, or just have questions?"
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Contact Us"
    description="Questions about joining, sponsoring, or anything else? We'd love to hear from you."
    breadcrumbs={breadcrumbs}
  />

  <section class="pb-12">
    <div class="max-w-5xl mx-auto px-6">
      <div class="max-w-2xl space-y-6">
        <div>
          <h2 class="text-lg font-bold text-[var(--ballrz-dark)] mb-2" style="font-family: var(--font-heading);">Get in Touch</h2>
          <p class="text-[var(--ballrz-gray-600)] text-[0.95rem] leading-relaxed mb-4">
            The best way to reach us is through our Facebook page or by emailing the team directly. We typically respond within a day or two.
          </p>
          {site.social.facebook && (
            <a href={site.social.facebook} class="inline-block px-5 py-2.5 bg-[var(--ballrz-primary)] text-white text-sm font-semibold rounded-lg hover:bg-[var(--ballrz-primary-dark)] transition-colors" style="font-family: var(--font-heading); letter-spacing: 0.04em;">
              Message Us on Facebook
            </a>
          )}
        </div>

        <div>
          <h2 class="text-lg font-bold text-[var(--ballrz-dark)] mb-2" style="font-family: var(--font-heading);">Want to Play?</h2>
          <p class="text-[var(--ballrz-gray-600)] text-[0.95rem] leading-relaxed">
            We welcome players of all skill levels. Reach out and we'll let you know about upcoming practices and how to get involved with <a href="https://www.softballaustin.org/" class="text-[var(--ballrz-purple)] hover:underline">Softball Austin</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
