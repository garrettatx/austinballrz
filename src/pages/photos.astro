---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageNav from '../components/PageNav.astro';
import PhotoModal from '../components/PhotoModal.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { photoYears } from '../data/photos';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Photos' }];
---

<Layout
  title={`Photos | ${site.name}`}
  description="Austin Ball'rz team photos from 2013 to present."
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Photos"
    description="Team photos from the present back to our founding in 2013."
    breadcrumbs={breadcrumbs}
  />

  <section class="section-sm">
    <div class="container" style="display: flex; flex-direction: column; gap: var(--space-8);">
      {photoYears.map(group => (
        <div>
          <h2 class="heading h4" style="margin-bottom: var(--space-2);">{group.heading || group.year}</h2>
          {group.description && <p class="mb-3" style="color: var(--color-muted); font-size: var(--text-sm);">{group.description}</p>}
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            {group.photos.map(photo => (
              <button class="overflow-hidden rounded-lg cursor-pointer photo-open" data-src={photo.src} data-alt={photo.alt}>
                <img src={photo.src} alt={photo.alt} class="w-full h-auto hover:scale-105 transition-transform duration-300" loading="lazy" />
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <PhotoModal />

  <PageNav currentPath="/photos/" />

  <Footer slot="footer" />
</Layout>
