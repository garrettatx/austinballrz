---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Layout title={`Page Not Found | ${site.name}`}>
  <Header slot="header" />

  <section class="section" style="padding-block: var(--space-16);">
    <div class="container text-center">
      <h1 class="heading h1" style="margin-bottom: var(--space-3);">404</h1>
      <p style="margin-bottom: var(--space-6);">This page doesn't exist.</p>
      <a href="/" class="btn btn-primary">Back to Home</a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
