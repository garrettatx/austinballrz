---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageNav from '../components/PageNav.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const breadcrumbs = [{ label: 'Softball Cheers' }];
---

<Layout
  title={`Softball Cheers | ${site.name}`}
  description="LGBTQ and other softball cheers for the Austin Ball'rz team."
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <PageHeader
    title="Softball Cheers"
    breadcrumbs={breadcrumbs}
  />

  <section class="section-sm">
    <div class="container">
      <div class="prose-width">
        <p>This page is on its way. Hang tight.</p>
      </div>
    </div>
  </section>

  <PageNav currentPath="/softball-cheers/" />

  <Footer slot="footer" />
</Layout>
