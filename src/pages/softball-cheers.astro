---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const pageName = 'Softball Cheers';
const breadcrumbs = [{ label: pageName }];
---

<Layout
  title={`${pageName} | ${site.name}`}
  jsonLd={breadcrumbSchema(breadcrumbs)}
>
  <Header slot="header" />

  <section class="py-12">
    <div class="max-w-3xl mx-auto px-6">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="text-3xl font-bold text-gray-900 mb-6">{pageName}</h1>
      <p class="text-gray-600">Content coming soon.</p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
